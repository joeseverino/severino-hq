{
  "schema_version": 1,
  "controller_id": "homelab-server",
  "capabilities": {
    "adguard.rewrite": {
      "actions": {
        "reconcile": {"mode": "apply"}
      }
    },
    "npm.proxy_host": {
      "actions": {
        "reconcile": {"mode": "apply"}
      }
    },
    "tls.certificate": {
      "actions": {
        "reconcile": {"mode": "apply"},
        "renew": {"mode": "apply"}
      }
    },
    "cloudflare.dns_record": {
      "actions": {
        "reconcile": {
          "mode": "locked",
          "reason": "Public DNS reconciliation is not enabled."
        }
      }
    }
  }
}
