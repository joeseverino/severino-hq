{
  "schema_version": 1,
  "capabilities": {
    "adguard.rewrite": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "cloudflare.dns_record": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "cloudflare.zone": {
      "actions": {
        "reconcile": {
          "mode": "locked",
          "reason": "Zone settings need a credential with Zone Settings:Edit, which the DNS token deliberately does not carry. Declaring a domain records what HQ is responsible for; it does not yet change anything about the zone itself."
        }
      }
    },
    "machine": {
      "actions": {
        "reconcile": {
          "mode": "locked",
          "reason": "A machine entry says what something is and where it answers. Nothing converges toward that -- HQ cannot make a printer exist, and the machines it can reach are found by sweeping a credential rather than by declaring one."
        }
      }
    },
    "npm.proxy_host": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "portainer.container": {
      "actions": {
        "reconcile": {
          "mode": "locked",
          "reason": "There is nothing to converge. A container's definition lives in whatever compose file created it, which HQ has never seen; this declaration records that HQ watches the container and may cycle it, not that HQ defines it."
        },
        "restart": {
          "mode": "apply",
          "automatic": false
        },
        "start": {
          "mode": "apply",
          "automatic": false
        },
        "stop": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "portainer.stack": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "tailscale.device": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true,
          "verification": {
            "timeout_seconds": 60,
            "interval_seconds": 10
          }
        },
        "approve-routes": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "tailscale.policy": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": false,
          "verification": {
            "timeout_seconds": 60,
            "interval_seconds": 10
          }
        }
      }
    },
    "tls.certificate": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "renew": {
          "mode": "apply",
          "automatic": true,
          "verification": {
            "timeout_seconds": 180,
            "interval_seconds": 5
          }
        }
      }
    },
    "tls.delivery_target": {
      "actions": {
        "reconcile": {
          "mode": "locked",
          "reason": "This states how a place takes a certificate. The certificates installed there are what get deployed and verified, each reporting its own arrival, so there is nothing here to converge on its own."
        }
      }
    },
    "tls.uploaded_certificate": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    }
  }
}
