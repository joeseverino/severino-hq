{
  "schema_version": 1,
  "capabilities": {
    "adguard.rewrite": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "npm.proxy_host": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "tls.certificate": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "renew": {
          "mode": "apply",
          "automatic": true,
          "verification": {
            "timeout_seconds": 180,
            "interval_seconds": 5
          }
        }
      }
    },
    "cloudflare.dns_record": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "cloudflare.zone": {
      "actions": {
        "reconcile": {
          "mode": "locked",
          "reason": "Zone settings need a credential with Zone Settings:Edit, which the DNS token deliberately does not carry. Declaring a domain records what HQ is responsible for; it does not yet change anything about the zone itself."
        }
      }
    },
    "tls.uploaded_certificate": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    }
  }
}
