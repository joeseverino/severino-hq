{
  "schema_version": 1,
  "controller_id": "homelab-server",
  "capabilities": {
    "adguard.rewrite": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "npm.proxy_host": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "delete": {
          "mode": "apply",
          "automatic": false
        }
      }
    },
    "tls.certificate": {
      "actions": {
        "reconcile": {
          "mode": "apply",
          "automatic": true
        },
        "renew": {
          "mode": "apply",
          "automatic": true,
          "verification": {
            "timeout_seconds": 180,
            "interval_seconds": 5
          }
        }
      }
    },
    "cloudflare.dns_record": {
      "actions": {
        "reconcile": {
          "mode": "locked",
          "reason": "Public DNS reconciliation is not enabled."
        }
      }
    }
  }
}
