{
  "schema_version": 1,
  "projections": {
    "login": {
      "CONNECTION_REF": {
        "source": "connection_ref"
      },
      "URL": {
        "source": "url",
        "index": 0
      },
      "USERNAME": {
        "source": "field",
        "id": "username"
      },
      "PASSWORD": {
        "source": "field",
        "id": "password"
      }
    },
    "api_token": {
      "CONNECTION_REF": {
        "source": "connection_ref"
      },
      "URL": {
        "source": "field",
        "label": "website"
      },
      "API_TOKEN": {
        "source": "field",
        "id": "credential"
      }
    },
    "ssh_transport": {
      "CONNECTION_REF": {
        "source": "connection_ref"
      },
      "HOST": {
        "source": "field",
        "label": "host"
      },
      "PORT": {
        "source": "field",
        "label": "port"
      },
      "USER": {
        "source": "field",
        "label": "user"
      },
      "HOST_KEY": {
        "source": "field",
        "label": "host_key"
      }
    }
  },
  "connections": {
    "homelab-adguard": {
      "provider": "adguard",
      "projection": "login",
      "env_prefix": "ADGUARD"
    },
    "homelab-npm": {
      "provider": "npm",
      "projection": "login",
      "env_prefix": "NPM"
    },
    "cloudflare-dns-jseverino": {
      "provider": "cloudflare_dns",
      "projection": "api_token",
      "env_prefix": "CLOUDFLARE_DNS"
    },
    "edge": {
      "provider": "ssh",
      "projection": "ssh_transport",
      "env_prefix": "EDGE"
    },
    "namecheap-cpanel": {
      "provider": "ssh",
      "projection": "ssh_transport",
      "env_prefix": "NAMECHEAP_CPANEL"
    }
  }
}
