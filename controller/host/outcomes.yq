# outcomes.gen.go from deploy/outcomes.json: each outcome a variable named for
# it, so hq-host's exit statuses and HQ's reading of a deployment are the
# declaration's, and a name the code uses that the declaration drops fails to
# build.
.outcomes as $outcomes |
(if ($outcomes | length) == 0 then error("deploy/outcomes.json declares no outcome") else . end) |
($outcomes | to_entries | map(
  .key as $name |
  .value as $outcome |
  (if ($outcome.state | test("^(error|failure|inactive|success)$")) | not then error("outcome " + $name + ": " + $outcome.state + " is not a state a deploy ends in") else . end) |
  (if ($outcome.production | test("^(release|previous|unknown)$")) | not then error("outcome " + $name + ": production is release, previous or unknown") else . end) |
  ($name | split("-") | map((.[:1] | upcase) + .[1:]) | join("")) as $ident |
  {
    "ident": "Deploy" + $ident,
    "line": "// Deploy" + $ident + " is the outcome deploy/outcomes.json names " + $name + ".\nvar Deploy" + $ident +" = DeployOutcome{Name: " + ($name | @json) + ", Exit: " + (($outcome.exit // "NeverExited") | tostring) + ", State: " + ($outcome.state | @json) + ", Production: " + ($outcome.production | @json) + ", CheckFailed: " + ($outcome.check_failed | tostring) + ", Description: " + ($outcome.description | @json) + "}"
  }
)) as $declared |
"// Code generated by go generate from deploy/outcomes.json; DO NOT EDIT.

package host

" + ($declared | map(.line) | join("\n\n")) + "

// DeployOutcomes is every outcome deploy/outcomes.json declares, in its order.
var DeployOutcomes = []DeployOutcome{" + ($declared | map(.ident) | join(", ")) + "}"
