# verifier.gen.go from mise.lock's cosign entry for linux-x64, the host's
# platform, so the host verifies with the release every workflow installs.
# Its checksum is the one mise checked against cosign's signed checksums.
(.tools.cosign // []) as $releases |
(if ($releases | length) != 1 then error("mise.lock records no single cosign release: run mise lock cosign") else . end) |
$releases[0] as $cosign |
($cosign."platforms.linux-x64".checksum // "") as $checksum |
($cosign."platforms.linux-x64".url // "") as $url |
(if ($checksum | test("^sha256:[0-9a-f]{64}$")) | not then error("mise.lock records no sha256 checksum for cosign on linux-x64") else . end) |
(if ($url | test("^https://github[.]com/sigstore/cosign/releases/download/")) | not then error("mise.lock's cosign url for linux-x64 is not a sigstore/cosign release") else . end) |
($checksum | sub("^sha256:"; "")) as $sha256 |
"// Code generated by go generate from mise.lock; DO NOT EDIT.

package host

// The cosign release mise.lock records for linux-x64: the verifier the host
// installs is the release every workflow signs and verifies with.
const (
	CosignVersion = \"v\($cosign.version)\"
	CosignSHA256  = \"\($sha256)\"
	CosignURL     = \"\($url)\"
)"
