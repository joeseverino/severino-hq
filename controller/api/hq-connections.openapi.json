{
  "openapi": "3.2.0",
  "info": {
    "title": "HQ controller connections",
    "version": "2.0.0",
    "description": "The document that carries provider connections from the secret renderer to the controller. It is a file, not an API: there are no paths. Emitted from the connection shapes HQ's registry declares; the Go types both programs use are generated from it."
  },
