# failure.gen.go from the bridge contract's RenderFailure: each word a failed
# run is filed under, a constant named as the contract names it. The renderer
# links no generated bridge client, so its words are generated on their own,
# and a word HQ drops, and so no longer explains, fails to build.
.components.schemas.RenderFailure as $failure |
(if (($failure.enum // []) | length) == 0 then error("the bridge contract declares no RenderFailure") else . end) |
($failure."x-enum-varnames") as $names |
"// Code generated by go generate from api/hq-controller.openapi.json; DO NOT EDIT.

package secrets

// Failure is a word a failed run is filed under, as HQ declares and explains it.
type Failure string

" + ($failure.enum | to_entries | map("const " + $names[.key] + " Failure = \"" + .value + "\"") | join("\n")) + "

// Failures is every word HQ declares, in its order.
var Failures = []Failure{" + ($names | join(", ")) + "}"
