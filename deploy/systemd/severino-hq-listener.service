[Unit]
Description=Severino HQ inbound-events listener
# Stopped and started with HQ, so it runs the image HQ runs, and the release
# that comes up is told it reconnected and reads again what it may have missed.
PartOf=severino-hq-web.service
After=network-online.target docker.service severino-hq-secrets.service severino-hq-web.service
Wants=network-online.target
Requires=docker.service
# Started again however often it fails.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
# Root executes only root-owned code, as the controller unit does.
WorkingDirectory=/usr/local/lib/severino-hq
# Holds the Worker's socket until stopped, reconnecting on its own. With no
# events connection it exits 0, which Restart=on-failure leaves stopped
# (systemd.service: on-failure restarts "when the process exits with a
# non-zero exit code"), so a host without one runs nothing and raises
# nothing; severino-hq-listener.path starts it when a render gives it one.
# One that fails is started again after a short wait.
ExecStart=/usr/local/lib/severino-hq/deploy/bin/hq-host controller --events
Restart=on-failure
RestartSec=5s

# Never more than the controller unit is given, and no certificate state.
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
