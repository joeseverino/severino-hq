[Unit]
Description=Run Renovate over the repositories HQ opted in
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/usr/local/lib/severino-hq
ExecStart=/usr/local/lib/severino-hq/deploy/bin/hq-host renovate
# Every owner's run ends by its token's expiry, an hour after it was minted,
# and its container is then removed (tested against TokenLife).
TimeoutStartSec=75min
# Renovate's log and the outcome the next controller pass is given.
LogsDirectory=severino-hq
LogsDirectoryMode=0700
StateDirectory=severino-hq/renovate
StateDirectoryMode=0700

ReadWritePaths=/run/severino-hq-renovate
