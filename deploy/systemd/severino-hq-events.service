[Unit]
Description=Severino HQ host events
# Reads Docker's event stream and systemd's job ends, and tells the running
# HQ of each change to a container and each job that failed. While HQ cannot
# answer, it reads again and tells HQ it reconnected. Restarted with HQ, so a
# release's hq-host is the one that runs.
PartOf=severino-hq-web.service
After=docker.service dbus.service severino-hq-web.service
Requires=docker.service
# Started again however often it ends.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
# Root executes only root-owned code, as the controller unit does.
WorkingDirectory=/usr/local/lib/severino-hq
# Holds both streams until stopped, reading them again on its own whenever
# one drops. It needs nothing beyond the shared sandbox: Docker's socket and
# the system bus are files, and it lends no run directory, so it writes
# nowhere.
ExecStart=/usr/local/lib/severino-hq/deploy/bin/hq-host events
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
