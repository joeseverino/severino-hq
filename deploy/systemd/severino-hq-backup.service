[Unit]
Description=Create and verify a Severino HQ backup
Documentation=https://github.com/joeseverino/severino-hq/blob/main/docs/Backup.md
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/severino-hq/backup.env
Environment=SEVERINO_BACKUP_REQUIRE_ENCRYPTION=1
Environment=SEVERINO_BACKUP_RETENTION_DAYS=30
# Over HQ's volumes, where docker says they are. A missing database fails the
# run, and the failure is reported, rather than the run being skipped.
ExecStart=/usr/local/lib/severino-hq/deploy/bin/hq-host backup
# A backup is seconds. A oneshot has no start timeout of its own, and one
# that hangs keeps its timer from ever firing again.
TimeoutStartSec=30min

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# The archives, and the database's directory: SQLite writes its shared-memory
# file beside a WAL database it only reads. A docker with another data root
# has no such path, and the snapshot then fails rather than being skipped.
ReadWritePaths=/srv/severino-hq/backups -/var/lib/docker/volumes/severino-hq_severino_data/_data
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
