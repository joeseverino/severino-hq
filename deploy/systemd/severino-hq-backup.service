[Unit]
Description=Create and verify a Severino HQ backup
Documentation=file:///opt/apps/severino-hq/docs/BACKUP.md
After=local-fs.target
ConditionPathExists=/srv/severino-hq/data/severino.sqlite3

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/severino-hq/backup.env
Environment=SEVERINO_BACKUP_REQUIRE_ENCRYPTION=1
Environment=SEVERINO_BACKUP_RETENTION_DAYS=30
# Root-owned copy, refreshed from the signed image on every deploy. See the
# comment in severino-hq-controller.service for why root does not execute
# out of the deploy checkout.
ExecStart=/usr/local/lib/severino-hq/scripts/backup.sh
# A backup is seconds. A oneshot has no start timeout of its own, and one
# that hangs keeps its timer from ever firing again.
TimeoutStartSec=30min

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/srv/severino-hq
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
