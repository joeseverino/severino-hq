# Drop-in for the GitHub Actions runner unit, installed by hand because the
# unit itself is generated by the runner's own installer and is overwritten
# whenever the runner is reconfigured.
#
# The runner ships configured to run as root. It executes whatever a workflow
# in the repository tells it to, so root is the one account it must not be.
# Install as:
#   /etc/systemd/system/actions.runner.<owner>-<repo>.<host>.service.d/10-runner-identity.conf
[Service]
User=hqrunner
