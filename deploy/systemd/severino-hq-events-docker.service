[Unit]
Description=Severino HQ Docker events
# Reads Docker's event stream and tells the running HQ of each change to a
# container. While HQ cannot answer, the stream is read again from the last
# event HQ stored. Restarted with HQ, so a release's hq-host is the one that
# runs.
PartOf=severino-hq-web.service
After=docker.service severino-hq-web.service
Requires=docker.service
# Started again however often it ends.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
# Root executes only root-owned code, as the controller unit does.
WorkingDirectory=/usr/local/lib/severino-hq
# Holds the stream until stopped, reading it again on its own whenever it
# drops. It needs nothing beyond the shared sandbox: Docker's socket is a
# file, and it lends no run directory, so it writes nowhere.
ExecStart=/usr/local/lib/severino-hq/deploy/bin/hq-host events
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
