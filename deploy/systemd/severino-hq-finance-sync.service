[Unit]
Description=Refresh Severino HQ finance balances
Wants=network-online.target
After=network-online.target docker.service severino-hq.service

[Service]
Type=oneshot
# Runs inside the running app container, which already holds the provider
# credentials and the token-encryption key rendered from 1Password by
# refresh-secrets. No credential handling belongs here.
ExecStart=/usr/bin/docker exec severino-hq python manage.py finance_sync

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
