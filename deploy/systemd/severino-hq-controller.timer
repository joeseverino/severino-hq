[Unit]
Description=Run Severino HQ infrastructure controller

[Timer]
# A floor, not the schedule: HQ rings the doorbell (the .path unit) when work
# is queued or a pass comes due. This catches a doorbell missed while the host
# was off, a claim whose controller died, and the day's automatic work.
# Must equal CONTROLLER_FLOOR in hq/platform/application/cadence.py (tested).
OnBootSec=2min
OnUnitInactiveSec=15min
RandomizedDelaySec=5s
Persistent=true
Unit=severino-hq-controller.service

[Install]
WantedBy=timers.target
