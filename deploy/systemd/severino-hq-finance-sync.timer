[Unit]
Description=Daily refresh of Severino HQ finance balances

[Timer]
# 07:00 in the application's timezone, stated explicitly rather than left to
# the host's. The homelab runs Etc/UTC while Django runs America/Chicago, so a
# bare "07:00:00" fired at 02:00 local -- and the run hour has to agree with
# the zone that stamps each reading's date, or the daily series is labelled
# from one clock and collected on another.
#
# Keep this in step with DJANGO_TIME_ZONE. The timezone suffix needs systemd
# 252 or newer; the homelab is on 259.
OnCalendar=*-*-* 07:00:00 America/Chicago
# The provider's hourly call budget is far above what one run costs, so the
# jitter is not about rate limits. It is about not being one of a thousand
# integrations hitting the same institution at exactly 07:00:00.
RandomizedDelaySec=10min
# A machine asleep at 07:00 refreshes when it wakes instead of skipping the
# day, which is what keeps the daily series continuous.
Persistent=yes
Unit=severino-hq-finance-sync.service

[Install]
WantedBy=timers.target
