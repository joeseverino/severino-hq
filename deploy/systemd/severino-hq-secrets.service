[Unit]
Description=Write Severino HQ secrets from 1Password Connect
Documentation=https://www.1password.dev/connect/api-reference
Wants=network-online.target
After=network-online.target docker.service
# The credential directory is a mount of its own, and the render must not run
# without it: RequiresMountsFor both orders and requires, so a missing mount
# fails the unit rather than quietly rendering onto an unprotected directory.
#
# A [Unit] key. Under [Service] systemd logs "Unknown key ... ignoring" and
# starts anyway, which is the failure that looks like success.
RequiresMountsFor=/run/severino-hq-secrets

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# The endpoint, the vault and the credential are configured in a host-owned
# drop-in (severino-hq-secrets-connect.conf.example). There is no default.
#
# The credential directory is a mount of its own
# (run-severino\x2dhq\x2dsecrets.mount), because it has to carry `noswap` and
# RuntimeDirectory cannot express that: tmpfs is swappable by default, and
# this host has a swap file, so every provider credential rendered here could
# otherwise be written to the disk by the kernel. It is not a
# RuntimeDirectory as well: a path with two owners is re-created on every
# start, and the mount then returns after being stopped. One owner, always.
#
# The sandbox (severino-hq-.service.d/20-sandbox.conf) mounts the whole
# hierarchy read-only, so write access is granted here; without it the render
# fails on a directory it cannot write.
ReadWritePaths=/run/severino-hq-secrets
ReadWritePaths=/opt/apps/severino-hq/secrets
# Root-owned copy of the binary the signed image built, refreshed on every
# deploy. See the comment in severino-hq-controller.service for why root does
# not execute out of the deploy checkout.
ExecStart=/usr/local/lib/severino-hq/deploy/bin/hq-secrets
# The render retries Connect for up to 75 seconds, waits up to 60 for a
# launcher holding the identity lock and up to 60 for a restarted web
# container, after the restart itself; this is the bound on all of it.
TimeoutStartSec=240

# The tmpfs is noswap; this keeps the secrets in the renderer's own memory out
# of swap and out of a core file as well. The bounds are far above what one
# render and one docker CLI use, and stop a runaway before the host notices.
MemorySwapMax=0
MemoryMax=512M
TasksMax=128
LimitCORE=0

# Run at boot, beside HQ, which waits for what this renders.
[Install]
WantedBy=multi-user.target
