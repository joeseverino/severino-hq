[Unit]
Description=Refresh Severino HQ secrets from 1Password
Documentation=https://developer.1password.com/docs/cli/secrets-scripts/
Wants=network-online.target
After=network-online.target docker.service
# The credential directory is a mount of its own, and the render must not run
# without it: RequiresMountsFor both orders and requires, so a missing mount
# fails the unit rather than quietly rendering onto an unprotected directory.
#
# A [Unit] key. Under [Service] systemd logs "Unknown key ... ignoring" and
# starts anyway, which is the failure that looks like success.
RequiresMountsFor=/run/severino-hq-secrets

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# Configure the backend and its credential in a host-owned drop-in.
Environment=OP_CONFIG_DIR=/run/severino-hq-op
# Only the op config directory. The credential directory is a mount of its own
# (run-severino\x2dhq\x2dsecrets.mount), because it has to carry `noswap` and
# RuntimeDirectory cannot express that -- tmpfs is swappable by default, and
# this host has a swap file, so every provider credential rendered here could
# otherwise be written to the disk by the kernel.
#
# Naming it in both places is what must not happen. systemd re-creates and
# re-mounts a RuntimeDirectory on every start, so a path listed here AND backed
# by a .mount unit has two owners: the mount returns after being stopped and
# even after being masked, the service's namespace sees two mounts where it saw
# one, and the tmpfs guard in controller-env.sh rejects the directory for being
# better protected than a plain one. That cost an hour of failed refreshes on
# 2026-09-21 and left the directory it was meant to protect empty, with the real
# credential shadowed underneath.
RuntimeDirectory=severino-hq-op
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# ProtectSystem=strict below mounts the whole hierarchy read-only, and
# RuntimeDirectory was what made the credential directory writable. Taking the
# path out of RuntimeDirectory therefore removes write access unless it is
# granted back here, and the render fails on a directory it cannot write.
ReadWritePaths=/run/severino-hq-secrets
# Root-owned copy, refreshed from the signed image on every deploy. See the
# comment in severino-hq-controller.service for why root does not execute
# out of the deploy checkout.
ExecStart=/usr/local/lib/severino-hq/scripts/refresh-secrets.sh

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/opt/apps/severino-hq/secrets
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
