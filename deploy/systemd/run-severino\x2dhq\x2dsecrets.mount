[Unit]
Description=Severino HQ credential tmpfs, kept out of swap
Documentation=https://github.com/joeseverino/severino-hq/blob/main/docs/Secrets.md
Before=docker.service severino-hq-secrets.service

[Mount]
What=tmpfs
Where=/run/severino-hq-secrets
Type=tmpfs
# noswap: a plain tmpfs pages to swap, and this holds every credential HQ
# renders. Root's alone, and nothing on it runs.
Options=rw,nosuid,nodev,noexec,noswap,mode=0700,uid=0,gid=0,size=1M

[Install]
WantedBy=multi-user.target
