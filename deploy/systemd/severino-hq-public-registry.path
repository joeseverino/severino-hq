[Unit]
Description=Read new images into Severino HQ when a sweep finds one
# The doorbell is a file HQ replaces when a sweep finds an image or digest it
# has not read. It carries nothing: forged or replayed, the worst it causes is
# a read that finds nothing due, which makes no request at all.

[Path]
PathChanged=/run/severino-hq/registry-doorbell
Unit=severino-hq-public-registry.service

[Install]
WantedBy=paths.target
