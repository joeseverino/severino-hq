[Unit]
Description=Severino HQ infrastructure controller
After=network-online.target docker.service severino-hq-secrets.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/apps/severino-hq
ExecStart=/opt/apps/severino-hq/scripts/run-controller.sh --apply

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run /opt/apps/severino-hq/secrets/acme
