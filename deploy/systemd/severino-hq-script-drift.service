[Unit]
Description=Check that the host is its release: the root-owned tree, the units and nothing else
Documentation=https://github.com/joeseverino/severino-hq/blob/main/docs/Deployment.md

[Service]
Type=oneshot
ExecStart=/usr/local/lib/severino-hq/deploy/bin/hq-host verify
# Reads the tree, the units and one image. A oneshot has no start timeout of
# its own, and one that hangs keeps its timer from firing again.
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
