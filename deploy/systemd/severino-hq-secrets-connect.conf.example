# Install as a secrets.service drop-in only after provisioning and validation.
# Replace the example port and unit name with host-owned composition settings.
[Unit]
# Requires, not Wants: a Connect that failed to start stops the render rather
# than leaving its port unanswered, and a timer that fires while Connect is
# down starts Connect first. Not BindsTo: that would also kill a render in the
# middle of its install whenever Connect stopped, and the port rule below
# already covers a Connect that dies while a render runs.
Requires=example-connect.service
After=docker.service example-connect.service

[Service]
# The credential is named for the consumer that holds it. Another consumer on
# this host (a different app needing a different vault) installs its own
# drop-in with its own name and its own read-only token, rather than sharing
# this one. Reused credential names silently clobber each other.
LoadCredentialEncrypted=
LoadCredentialEncrypted=op_connect_hq_renderer
Environment=SEVERINO_CONNECT_CREDENTIAL=op_connect_hq_renderer
# IPv4 loopback, on a port below 1024, and nothing else: the renderer refuses
# any other endpoint and its dialer refuses any other address. Only root can
# listen on such a port, so only root's Connect can receive the token. Publish
# Connect there (for a container, `127.0.0.1:880:8080`).
Environment=OP_CONNECT_HOST=http://127.0.0.1:880

# Estate naming, supplied here rather than committed. Replace with this host's
# real vault and item names; they are deliberately not defaulted in the program.
Environment="SEVERINO_SECRETS_VAULT=Example Vault"
Environment="SEVERINO_ENV_ITEM=example env"
