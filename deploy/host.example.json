{
  "vault": "Example Vault",
  "env_item": "example env",
  "connect": {
    "unit": "example-connect.service",
    "url": "http://127.0.0.1:880",
    "credential": "op_connect_example"
  },
  "runner": {
    "unit": "actions.runner.example-owner-severino-hq.example-host.service",
    "user": "hqrunner"
  },
  "grants": [
    {
      "name": "example-pull",
      "repositories": ["example/notes"],
      "permissions": {"contents": "read", "metadata": "read"},
      "path": "/run/example-pull/github_token"
    },
    {
      "name": "automation-projects",
      "repositories": ["example/playbooks"],
      "permissions": {"contents": "read", "metadata": "read"},
      "path": "/run/severino-hq-automation/github_token"
    }
  ],
  "automation": {
    "repository": "example/playbooks",
    "directory": "ansible",
    "grant": "automation-projects"
  }
}
