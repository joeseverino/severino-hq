#!/bin/sh
set -eu

readonly operation="${1:-}"

# Bumped whenever an operation is added. The controller asks for this, so a
# target older than the controller says so plainly instead of refusing an
# operation it has simply never heard of.
readonly target_version=2
readonly cert_dir="${SEVERINO_HQ_CADDY_CERT_DIR:-/opt/apps/caddy/certs}"
readonly routes_file="${SEVERINO_HQ_CADDY_ROUTES:-/opt/apps/caddy/config/hq-routes.caddy}"
readonly cert_owner="${SEVERINO_HQ_CERT_OWNER:-root}"
readonly cert_group="${SEVERINO_HQ_CERT_GROUP:-root}"

case "${operation}" in
    version)
        echo "${target_version}"
        ;;
    preflight)
        test -s "${cert_dir}/fullchain.pem"
        test -s "${cert_dir}/privkey.pem"
        docker inspect caddy >/dev/null
        ;;
    snapshot)
        exec tar -C "${cert_dir}" -cf - fullchain.pem privkey.pem
        ;;
    perimeter)
        # What this machine is relying on to stay shut, as it is right now.
        #
        # Reported rather than asserted, and each part says whether it could be
        # read at all: a control this cannot see is unknown, which is a
        # different thing from one it has seen to be off. Claiming the second
        # when it means the first is how a report becomes worse than none.
        #
        # Unprivileged on purpose. Reading the container chain needs root and
        # this account does not have it, so that half is answered by whether
        # the ports actually answer, from somewhere outside -- a question about
        # the property rather than about the configuration behind it.
        nftables="$(systemctl is-active nftables 2>/dev/null || true)"
        # Its own public face, so the half that needs root is answered from
        # outside instead. Every address on an interface that is neither
        # private nor tailnet: derived, so a machine that is renumbered or
        # given a second address is still described correctly.
        public="$(
            ip -4 -o addr show scope global 2>/dev/null \
                | awk '{split($4, a, "/"); print a[1]}' \
                | grep -vE '^(10\.|127\.|169\.254\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)' \
                | paste -sd, - || true
        )"
        printf '{"record":"perimeter","firewall_unit":"%s","public_addresses":"%s","read_at":"%s"}\n' \
            "${nftables:-unknown}" "${public}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        ;;
    routes)
        # What this edge actually serves, so HQ stops having to be told. The
        # names here answer over TLS from a box HQ sweeps, holds a credential
        # for and installs certificates on -- and every service page for one of
        # them read "nothing supplies this", because the only ingress HQ could
        # describe was a proxy this box does not run.
        #
        # Adapted rather than read: a Caddyfile is a syntax, and the JSON it
        # adapts to is the structure Caddy itself works from. Deploy reloads
        # from this same file, so it is also what is running.
        #
        # Emitted whole and parsed by HQ. Parsing it here would put the one part
        # of this likely to need changing on a host that takes a root install to
        # update, while the repository keeps the half that never moves.
        exec docker exec caddy caddy adapt --config /etc/caddy/Caddyfile
        ;;
    routes:write)
        # The routes HQ declares, and only those. They go in a file of their
        # own that the operator's Caddyfile imports, so HQ never edits a line
        # somebody else wrote -- health.jseverino.com answers with `respond`,
        # which no route HQ can declare expresses, and a writer that owned the
        # whole file would have had to reproduce it or drop it.
        #
        # Validated before it is installed and rolled back if the reload fails,
        # the same shape the certificate deploy uses. A Caddyfile that does not
        # parse takes every name on this box down, so the failure has to happen
        # while the old one is still the one running.
        work="$(mktemp -d /tmp/severino-hq-routes.XXXXXX)"
        trap 'rm -rf "${work}"' EXIT HUP INT TERM
        cat >"${work}/hq-routes.caddy"
        test -s "${work}/hq-routes.caddy"
        # Parsed on its own first. This catches a malformed route while the
        # running config is still the old one, which is the only moment it can
        # be caught cheaply -- a Caddyfile that does not parse takes every name
        # on this box down. It cannot catch a *conflict* with the operator's own
        # file, because the two are only one config once installed; the reload
        # below is what catches that, and it rolls back when it does.
        docker cp "${work}/hq-routes.caddy" caddy:/tmp/hq-routes.candidate
        docker exec caddy caddy validate --adapter caddyfile \
            --config /tmp/hq-routes.candidate
        if [ -f "${routes_file}" ]; then
            install -m 0644 "${routes_file}" "${work}/previous.caddy"
        else
            : >"${work}/previous.caddy"
        fi
        install -o "${cert_owner}" -g "${cert_group}" -m 0644 "${work}/hq-routes.caddy" "${routes_file}"
        if ! docker exec caddy caddy reload --config /etc/caddy/Caddyfile --force; then
            install -o "${cert_owner}" -g "${cert_group}" -m 0644 "${work}/previous.caddy" "${routes_file}"
            docker exec caddy caddy reload --config /etc/caddy/Caddyfile --force
            echo "Severino HQ route reload failed; previous routes restored." >&2
            exit 1
        fi
        ;;
    deploy)
        work="$(mktemp -d /tmp/severino-hq-cert.XXXXXX)"
        archive="$(mktemp /tmp/severino-hq-certificate.XXXXXX.tar)"
        trap 'rm -rf "${work}"; rm -f "${archive}"' EXIT HUP INT TERM
        cat >"${archive}"
        test "$(tar -tf "${archive}" | sort)" = "fullchain.pem
privkey.pem"
        tar -C "${work}" -xf "${archive}"
        test "$(find "${work}" -type f -maxdepth 1 -exec basename {} \; | sort)" = "fullchain.pem
privkey.pem"
        # One openssl stage per line so `set -e` sees each one fail. A pipeline
        # would report only the last stage's status, and `openssl dgst` succeeds
        # on empty input. Not `set -o pipefail`: dash rejects it (SC3040).
        cert_public="$(openssl x509 -in "${work}/fullchain.pem" -pubkey -noout)"
        cert_der="$(printf '%s\n' "${cert_public}" | openssl pkey -pubin -outform DER)"
        cert_key="$(printf '%s' "${cert_der}" | openssl dgst -sha256)"
        key_der="$(openssl pkey -in "${work}/privkey.pem" -pubout -outform DER)"
        private_key="$(printf '%s' "${key_der}" | openssl dgst -sha256)"
        if [ "${cert_key}" != "${private_key}" ]; then
            echo "Refusing: the private key does not match the certificate." >&2
            exit 1
        fi
        # An expired certificate parses perfectly and reloads without complaint,
        # so nothing above would notice one. Caddy would serve it until a browser
        # objected.
        if ! openssl x509 -in "${work}/fullchain.pem" -checkend 0 >/dev/null; then
            echo "Refusing: the certificate has already expired." >&2
            exit 1
        fi
        install -m 0600 "${cert_dir}/fullchain.pem" "${work}/previous-fullchain.pem"
        install -m 0600 "${cert_dir}/privkey.pem" "${work}/previous-privkey.pem"
        install -o "${cert_owner}" -g "${cert_group}" -m 0644 "${work}/fullchain.pem" "${cert_dir}/fullchain.pem"
        install -o "${cert_owner}" -g "${cert_group}" -m 0600 "${work}/privkey.pem" "${cert_dir}/privkey.pem"
        if ! docker exec caddy caddy reload --config /etc/caddy/Caddyfile --force; then
            install -o "${cert_owner}" -g "${cert_group}" -m 0644 "${work}/previous-fullchain.pem" "${cert_dir}/fullchain.pem"
            install -o "${cert_owner}" -g "${cert_group}" -m 0600 "${work}/previous-privkey.pem" "${cert_dir}/privkey.pem"
            docker exec caddy caddy reload --config /etc/caddy/Caddyfile --force
            exit 1
        fi
        ;;
    *)
        # Name the operation and the version. This refusal is indistinguishable
        # from a stale target otherwise, and a target that has not been
        # reinstalled for weeks fails every deploy while reporting only a
        # number -- which is how one sat three versions behind unnoticed.
        echo "Severino HQ edge target v${target_version} does not implement '${operation}'." >&2
        echo "If the controller expects it, this target is older than the controller." >&2
        exit 126
        ;;
esac
