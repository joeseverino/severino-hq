#!/bin/sh
#MISE description="The suite composed with the set mise.local.toml names, as the image runs it; mise run test --composed"
#MISE hide=true
#MISE extends="django"
#MISE env={DJANGO_DEBUG=false, SEVERINO_WAITS_FOR_HEAVY_TURN="1"}
#USAGE arg "[arguments]..." var=#true help="Passed on to manage.py test: test labels, --tag, --parallel"

# The suite runs in a copy of only what the image's /app holds
# (tools/lib/image-tree.sh, which image:verify:tree holds to the image), so a
# test that reads docs/, .git or anything else the image leaves out fails here
# rather than in Compose.
# It runs as the image configures it: DEBUG off, the extension set
# mise.local.toml names (tools/lib/extension-set.sh, whose first line names
# each package's tree), with SEVERINO_HQ_SOURCE and SEVERINO_HQ_REVISION
# stamped. Without an extension set it runs the host alone and says so;
# REQUIRE_COMPOSED=1 fails instead.
set -eu

if [ -z "${HQ_LOCAL_PLUGINS:-}" ] && [ "${REQUIRE_COMPOSED:-0}" = 1 ]; then
    echo "The composed suite is required and HQ_LOCAL_PLUGINS is unset: name the set with mise run setup:extensions <checkout>." >&2
    exit 1
fi
# shellcheck source=tools/lib/extension-set.sh
. ./tools/lib/extension-set.sh
compose_extensions

# The whole suite takes the heavy turn; a run its arguments narrow goes ahead
# at once (tools/gate/turn.py).
test_arguments="${usage_arguments:-}"
turn_bound=30m
# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh

# shellcheck source=tools/lib/image-tree.sh
. ./tools/lib/image-tree.sh
# shellcheck source=tools/lib/source-url.sh
. ./tools/lib/source-url.sh

source_url="$(source_url)"
# Named as a test run's directory is, so a copy a killed run left is swept by
# a test run once it is older than any run (hq/config/sandbox.py).
tree="$(mktemp -d "${TMPDIR:-/tmp}/hq-run-XXXXXX")"
# This shell outlives the suite so the copy goes however it ends. A signal is
# acted on once the suite has stopped (a terminal's interrupt reaches both),
# and the exit says which signal it was.
trap 'rm -rf "${tree}"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

image_tree "${tree}"

# The image installs the runtime dependencies alone, so the suite runs in an
# environment of the checkout's that holds only those: a test module that loads
# a development tool fails here as it does in the image. It lives beside the
# checkout's own environment, not in the copy, so it outlives the run.
environment="${UV_PROJECT_ENVIRONMENT:-.venv}-image"
case "${environment}" in /*) ;; *) environment="${MISE_CONFIG_ROOT}/${environment}" ;; esac

# The verdict runs from the checkout, since the copy holds no tools/, and keeps
# the run's whole report in var/gate/test-composed.txt, named by its last line.
# The copy holds none of what a source test reads, so a named label leaves
# them out here too (lint:source runs them on the checkout).
revision="$(git rev-parse HEAD)"
status=0
env \
    UV_PROJECT_ENVIRONMENT="${environment}" \
    SEVERINO_HQ_SOURCE="${source_url}" \
    SEVERINO_HQ_REVISION="${revision}" \
    uv run --locked --no-default-groups python -m tools.gate.verdict test:composed \
    uv run --directory "${tree}" --locked --no-default-groups python manage.py test --noinput --parallel auto --exclude-tag=source "$@" \
    || status=$?
exit "${status}"
