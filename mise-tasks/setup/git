#!/bin/sh
#MISE description="Name the merge drivers .gitattributes asks for in the repository's git config, which every worktree shares; fast and fix run it first"
#MISE hide=true
#MISE quiet=true
# git reads a driver only from its config, never from the tree, so a clone
# that has not run this merges those files as text.
set -eu

# A file that only ever loses lines merges to the lines both sides kept, in
# the current side's order. grep exits 1 when no line is common, which is
# still a clean merge to an empty file; 2 is a failure, which git reads as a
# conflict. git hands each version over as a temporary file
# named .merge_file_ and six letters, which needs no quoting.
git config set merge.intersect-lines.name "the lines both sides kept"
git config set merge.intersect-lines.driver 'grep -Fxf %B %A >%A.kept; test $? -le 1 && mv %A.kept %A'
