#!/bin/sh
#MISE description="Ready what an audit task's sandbox needs before it opens: the project's environment synced, since the sandbox refuses uv's write of it, each lazy tool the task names installed, since the sandbox refuses a lazy tool's install on first use, and every path the sandbox lets it write made, since on Linux Landlock drops the rule for an allowed path that does not exist yet"
#MISE hide=true
#MISE env={SANDBOX_WRITES="{% if os() == 'macos' %}{{ exec(command='getconf DARWIN_USER_TEMP_DIR') }}{% else %}{{ get_env(name='TMPDIR', default='') }}{% endif %}:{% if os() == 'macos' %}{{ env.HOME }}/Library/Caches{% else %}{{ xdg_cache_home }}{% endif %}/go-build:var/perf:var/audit/tests"}
#USAGE arg "[tool]..." var=#true help="The lazy tools the audit task runs, as mise.toml names them (ripgrep, aqua:Zxilly/go-size-analyzer), each installed at its pin"

# SANDBOX_WRITES is the audit template's allow_write and each audit task's
# own, joined by colons; test_audit_tasks.py holds it to them, and an audit
# task's tools to the lazy commands it runs.
set -euf

# Inexact: an exact sync would uninstall the groups other tasks' `uv run
# --group` installed beside it (tools/tests/test_task_syncs.py).
uv sync --locked --inexact --quiet

# A bare `mise install` would install every tool, so only named ones run it.
if [ -n "${usage_tool:-}" ]; then
    eval "set -- ${usage_tool}"
    mise install --quiet "$@"
fi

IFS=:
for path in $SANDBOX_WRITES; do
    if [ -n "$path" ]; then
        mkdir -p -- "$path"
    fi
done
