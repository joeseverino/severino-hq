#!/bin/sh
#MISE description="Install the browser engine the task is named for, at the release the locked Playwright pins"
#MISE hide=true
#MISE sources=["uv.lock"]

# One script, linked as each engine's task (setup:webkit, setup:chromium,
# setup:firefox), so the engine is the name it was run by. A browser removed by
# hand comes back with `mise run --force setup:<engine>`. CI's browser jobs run
# in Playwright's image, which carries the engines and their system libraries,
# so there this finds them installed.
set -eu

uv run --group browser python -m playwright install "${0##*/}"
