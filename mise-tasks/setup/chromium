#!/bin/sh
#MISE description="Install the Chromium the locked Playwright pins, for the leg that runs the layout gate in it"
#MISE hide=true
#MISE sources=["uv.lock"]

# The lock pins Playwright, which pins the browser. A browser removed by hand
# comes back with `mise run --force setup:chromium`. CI's browser jobs run in
# Playwright's image, which carries this browser and its system libraries, so
# there this finds it installed.
set -eu

uv run --group browser python -m playwright install chromium
