#!/bin/sh
#MISE description="To check the production images: build the host's and the automation worker's as CI builds them, then every image:verify:* check; with IMAGE set (and RUNNER_IMAGE, the worker's), check those images without a build"
#MISE lock=["gate", "heavy"]
#MISE timeout="1h"
#MISE depends_post=["image:docker stop"]
#USAGE flag "--tag <tag>" help="The name to build it as; severino-hq:ci-local by default"
#USAGE flag "--revision <commit>" help="The commit it is built for, HEAD by default; a pull request builds its head, not the merge it checks out"
#USAGE flag "--cache <ref>" help="A registry layer cache to read (image:build)"
#USAGE flag "--cache-write" help="Also write the layer cache (image:build)"
#USAGE flag "--runner-tag <tag>" default="severino-hq-runner:ci-local" help="The name to build the automation worker's image as"
#USAGE flag "--no-verify" help="Build only, as CI does before it publishes a pull request's image"

# IMAGE names a host image already built, which image:build then leaves alone
# and the checks read, and RUNNER_IMAGE the worker's image built beside it.
# Each check runs to the end, and the last lines name every one that failed.
set -eu
# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh
# The VM boots once the turn is this task's, so it never waits idle for one.
mise run image:docker start

set --
[ "${usage_cache_write:-}" != true ] || set -- --cache-write
mise run image:build ${usage_tag:+--tag "${usage_tag}"} ${usage_revision:+--revision "${usage_revision}"} \
    ${usage_cache:+--cache "${usage_cache}"} --runner-tag "${usage_runner_tag:?}" "$@"
[ "${usage_no_verify:-}" != true ] || exit 0
if [ -z "${IMAGE:-}" ]; then
    RUNNER_IMAGE="${usage_runner_tag}"
    export RUNNER_IMAGE
fi
if [ -n "${IMAGE:-${usage_tag:-}}" ]; then
    IMAGE="${IMAGE:-${usage_tag}}"
    export IMAGE
fi
# The image is built: its checks run without building it again.
exec mise run --skip-deps -c 'image:verify:*'
