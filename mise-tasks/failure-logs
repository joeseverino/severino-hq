#!/usr/bin/env bash
#MISE description="Open a failed Compose run's sealed logs"
#MISE hide=true
#MISE raw=true
#MISE env={SEVERINO_FAILURE_LOG_IDENTITY={required="The identity that decrypts sealed logs, an op:// reference or a file, set in mise.local.toml (docs/Development.md, The extension set)"}}
#USAGE arg "<run>" help="The Compose run whose logs were sealed"
#USAGE arg "[dir]" help="Where to unpack them; a private temporary directory by default"

# Downloads the run's failure-logs artifacts, one from each Compose job that
# failed, decrypts them with the identity named by SEVERINO_FAILURE_LOG_IDENTITY
# (an op:// reference or a file; mise.local.toml sets it) and unpacks them.
set -euo pipefail

identity="$SEVERINO_FAILURE_LOG_IDENTITY"

umask 077
dir="${usage_dir:-$(mktemp -d)}"
download="$(mktemp -d)"
trap 'rm -rf "$download"' EXIT
gh run download "${usage_run:?}" --pattern 'failure-logs*' --dir "$download"

# Read first, so a 1Password unlock that times out is reported as one.
case "$identity" in
  op://*) key="$(op read "$identity")" || { echo "1Password did not release the identity; approve the unlock and run again." >&2; exit 1; } ;;
  *) key="$(cat "$identity")" ;;
esac
mkdir -p "$dir"
while IFS= read -r -d '' sealed; do
  age --decrypt --identity <(printf '%s\n' "$key") "$sealed" | tar -xzf - -C "$dir"
done < <(find "$download" -name failure-logs.tar.age -print0)
unset key
echo "$dir"
find "$dir" -type f | sed "s|^$dir/|  |"
