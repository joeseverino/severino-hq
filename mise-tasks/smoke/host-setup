#!/bin/sh
#MISE description="To see the host's setup playbook (deploy/ansible/host.yml) hold its promises: applied, checked and drifted against a host made of directories by the runner group's ansible-playbook, systemd and visudo faked, with each run's wall time; --record rewrites the check report controller/host's tests read; outside check, since no gate installs that group"
#MISE hide=true
#USAGE flag "--record" help="Rewrite controller/host/testdata/setup-check.json from the drifted host's check"
set -eu
# shellcheck source=tools/lib/runner-environment.sh
. ./tools/lib/runner-environment.sh
if [ "${usage_record:-false}" = true ]; then
    set -- --record controller/host/testdata/setup-check.json
fi
exec "$runner_venv/bin/python" -m tools.pipeline.host_setup "$@"
