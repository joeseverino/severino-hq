#!/bin/sh
#MISE description="Build the public demo's static site into var/demo, another seed into var/demo-<seed>; nothing when that site is newer than its sources"
#MISE hide=true
#MISE extends="django"
#MISE timeout="30m"
#MISE sources=["hq/**/*", "hq_sdk/**/*", "templates/**/*", "static/**/*", "demo/**/*", "manage.py", "uv.lock", "!**/__pycache__/**"]
#MISE outputs=["var/demo{% if usage.seed != 'showcase' %}-{{ usage.seed }}{% endif %}/index.html"]
#USAGE arg "[seed]" default="showcase" {
#USAGE     choices "showcase" "standard" "empty"
#USAGE }
set -eu

# One process renders the pages through the test client, a narrow run that
# goes ahead beside heavy work (tools/gate/turn.py).

seed="${usage_seed:?}"
out=var/demo
[ "$seed" = showcase ] || out="var/demo-$seed"
HQ_DEMO_SEED="$seed" HQ_DEMO_OUT="$PWD/$out" uv run python manage.py test demo.build --noinput --parallel 1
