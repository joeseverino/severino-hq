#!/bin/sh
#MISE description="How light and fast each page is, in the server and in Chromium, with memory and cold start, beside a base's with --base"
#MISE extends="django"
#MISE depends=[{task="setup:browser", args=["chromium"]}]
#MISE env={SEVERINO_HQ_REQUIRE_PLUGIN_ADMISSION="0", SEVERINO_HQ_PLUGINS="{{ env.HQ_LOCAL_PLUGINS | default(value='') }}", PYTHONPATH="{{ env.HQ_LOCAL_PYTHONPATH | default(value='') }}"}
#MISE timeout="2h"
#USAGE arg "[pages]" help="Comma-separated pages as dev:look names them: estate/<path>, or estate/all or all, the default, for every page the navigation lists"
#USAGE flag "--image" help="Measure the built image instead of dev:scratch: the one IMAGE names, else one image:build makes for the commit"
#USAGE flag "--base <ref>" help="Also measure <ref>, in a temporary worktree removed however the run ends, and print each number beside how far it moved"
#USAGE flag "--host-alone" help="Measure the host with no extension composed, on both sides; a base that refuses the extension set for its plugin API is measured so on its own"
#USAGE flag "--fresh" help="Measure the base even when an earlier run kept a complete report of its commit holding these pages, under the same plan"
#USAGE flag "--requests <n>" default="20" help="Requests a page for the server's p50 and p95"

# The harness is tools/perf/report.py; each run is kept as var/perf/<run>.json.
set -eu

# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh

exec uv run --group browser python -m tools.perf.report
