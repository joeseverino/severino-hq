#!/bin/sh
#MISE description="Before handing work back, if the machine can hold it: every gate CI runs, lint, test, browser, build and scan; --release before a release"
#MISE raw=true
#MISE env={SEVERINO_WAITS_FOR_HEAVY_TURN="1"}
#USAGE flag "--release" help="Then the composed suite with the extensions required and the deploy host, read-only, on the committed HEAD: exit 0 means ready to release"
#USAGE flag "--remote" help="Read every check GitHub ran on this commit instead of running the gates here; the commit must be pushed"
#USAGE flag "--skip-host" help="A release run without the deploy host, exiting 2: not a verdict on the release"

# The verdict is tools/gate/check.py's. It holds no heavy turn of its own:
# each gate it runs, one at a time, takes the turn for what of it needs one.
set -eu

exec uv run python -m tools.gate.check
