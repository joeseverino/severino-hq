#!/bin/sh
#MISE description="Every shell file parses and passes shellcheck; the shell suites pass"
set -eu

sources="$(tools/gate/shell-sources.sh)"
# A file that does not parse in the dialect its first line names fails shellcheck.
# shellcheck disable=SC2086  # one path per word
shellcheck -x $sources
# Suites run in parallel (each uses its own temporary directory); a failed
# suite's output is printed whole, not interleaved.
logs="$(mktemp -d)"
trap 'rm -rf "$logs"' EXIT
for suite in tests/shell/test-*.sh; do
    name="${suite##*/}"
    { status=0; "$suite" >"$logs/$name.log" 2>&1 || status=$?; echo "$status" >"$logs/$name.status"; } &
done
wait
failed=0
for suite in tests/shell/test-*.sh; do
    name="${suite##*/}"
    if [ "$(cat "$logs/$name.status")" != 0 ]; then
        cat "$logs/$name.log"
        echo "$name failed" >&2
        failed=1
    fi
done
exit "$failed"
