#!/bin/sh
#MISE description="Every hosted job runs on the declared runner image"

# A job left on ubuntu-latest would move to a new OS on GitHub's schedule.
set -eu

stray="$(grep -HnE '^[[:space:]]*runs-on:' .github/workflows/*.yml \
    | grep -v 'self-hosted' \
    | grep -v "runs-on: ${RUNNER_IMAGE}\$" || true)"
if [ -n "$stray" ]; then
    printf '%s\n' "$stray" >&2
    echo "Hosted jobs must run on ${RUNNER_IMAGE} (scripts/toolchain.env)." >&2
    exit 1
fi
