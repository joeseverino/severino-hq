#!/bin/sh
#MISE description="A browser gate or test labels in the Playwright image CI's Browser job runs, on this checkout: a layout only CI's Linux shows, reproduced here"
#MISE timeout="60m"
#USAGE arg "<target>..." var=#true double_dash="automatic" help="A browser:* gate (browser:layout-chromium-1), or test labels then any manage.py test options, as mise run test takes them"
#USAGE flag "--engine <engine>" default="chromium" help="The engine test labels are drawn in; a gate keeps its own" {
#USAGE   choices "webkit" "chromium" "firefox"
#USAGE }

# The image and its options are the ones .github/workflows/ci.yml gives the
# Browser job, read from this checkout's copy, so a commit runs in the image
# its own CI used. Inside, tools/dev/browser-linux.sh sets up as the toolchain
# action does and runs the same mise task. What the setup downloads (mise, its
# tools, uv's cache and the environment) stays in the Docker volume
# severino-hq-browser-linux, so the next run starts at the gate.
set -eu

# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh
eval "set -- ${usage_target:?}"

docker info >/dev/null 2>&1 || {
    echo "No container runtime answers: start one with Rosetta first (colima start --cpu 4 --memory 5 --vz-rosetta)." >&2
    exit 69
}

workflow=.github/workflows/ci.yml
image="$(sed -n 's|^ *image: \(mcr\.microsoft\.com/playwright/[^ ]*\)$|\1|p' "${workflow}")"
options="$(sed -n '/^ *image: mcr\.microsoft\.com\/playwright\//{n;s/^ *options: //p;}' "${workflow}")"
case "${image}" in
    '' | *"
"*) echo "${workflow} does not name one Playwright image for the Browser job." >&2; exit 1 ;;
esac

# A gate names its own engine; labels are drawn in the one asked for.
case "$1" in
    browser:*) engine="" ;;
    *) engine="${usage_engine:?}" ;;
esac

checkout="${MISE_CONFIG_ROOT}"
# A worktree's .git is a file naming the repository's own, which the container
# needs at the same path to read the checkout's history.
common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
case "${common}" in
    "${checkout}"/*) git_mount="" ;;
    *) git_mount="--volume=${common}:${common}:ro" ;;
esac

# CI's runners are x64, the one Linux platform mise.lock records, so the image
# runs as linux/amd64, through Rosetta on Apple silicon: under QEMU, Chromium
# crashes as it starts.
# shellcheck disable=SC2086  # the workflow's options are several words; the git mount is one or none
exec docker run --rm --platform=linux/amd64 ${options} ${git_mount} \
    --volume=severino-hq-browser-linux:/home/pwuser \
    --volume="${checkout}:${checkout}" \
    --workdir="${checkout}" \
    --env=HOME=/home/pwuser \
    ${engine:+--env=HQ_BROWSER_ENGINE="${engine}"} \
    ${HQ_BROWSER_SLOW:+--env=HQ_BROWSER_SLOW="${HQ_BROWSER_SLOW}"} \
    ${HQ_BROWSER_FACE:+--env=HQ_BROWSER_FACE="${HQ_BROWSER_FACE}"} \
    "${image}" sh tools/dev/browser-linux.sh "$@"
