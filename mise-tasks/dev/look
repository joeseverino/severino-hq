#!/bin/sh
#MISE description="To see what a page change looks like: screenshots as the browser gates draw them, judged by a rule if asked; --docs to redraw the docs' pictures"
#MISE extends="django"
#MISE env={SEVERINO_WAITS_FOR_HEAVY_TURN="1"}
#MISE depends=[{task="setup:browser", args=["{{usage.engine}}"]}, "setup:lint-tools"]
#USAGE long_about "Each run shoots into a folder of its own, var/look/<when it began>/, named as the look closes; it removes the runs older than KEPT_FOR (a day) beyond the newest KEPT_RUNS (hq/platform/core/tests/look.py) as it starts.\n\nA page at the phone, 820 and 1360:\n  mise run dev:look estate/infrastructure/containers\n\nCommand Center's results for a term, the query riding on the page as it does on an address:\n  mise run dev:look 'search/?q=docker'\n\nA shared part as the component catalog draws it, an entry named by its family and name: each notice entry, a filter bar and one table, judged by every check the gates hold:\n  mise run dev:look --rule survey part/notice form/filter-bar table/figures\n\nA form as a reader sees it once refused, its errors drawn, by a POST named in hq/platform/core/tests/look_posts.py:\n  mise run dev:look post:project-create-blank\n\nAfter a change to a template, the first page of the estate or catalog entry that draws it:\n  mise run dev:look template:control_plane/_container_detail.html\n\nThe same with every row a reader can open opened, and var/probe.js (a function, such as () => document.title) run on what the screenshot shows:\n  mise run dev:look --expand --eval var/probe.js estate/infrastructure/containers\n\nWhich band file shows each heading, var/heads.js holding () => [...document.querySelectorAll('main h2')]:\n  mise run dev:look --widths 820 --eval var/heads.js connections\n\nOne probe of the survey's tried on a page, with the argument it takes:\n  mise run dev:look --probe boxes:ASIDES_WRAPPED_WITH_ROOM --arg '\".section-head\"' estate/projects/hq\n\nA candidate CSS fix judged against the tree as it stands, by every check the gates hold:\n  mise run dev:look --base HEAD --css var/fix.css --rule survey estate/projects/hq\n\nEvery page, judged by every check the browser gates hold, its findings without screenshots:\n  mise run dev:look --rule survey all\n\nThe same with the screenshots too:\n  mise run dev:look --rule survey --shots all\n\nA table finding the layout legs report at some width, reproduced as they find it (loaded at 320, then resized through every width the layout changes shape at):\n  mise run dev:look --rule a_table_fits_its_box_at_every_width --widths 320 services\n\nThe API reference with each tag opened, in the dark palette at 820 (the document is the registry's, the same on any data):\n  mise run dev:look --open --dark --widths 820 api/docs\n\nOne operation of the reference opened, its body and every response with each property in them; the shot's line names the band files that show it:\n  mise run dev:look --widths 820 --operation 'GET /api/v2/resources/projects/{identifier}/' api/docs\n\nThe host's and the extensions' pages together, as mise.local.toml composes them:\n  mise run dev:look --composed estate/all"
#USAGE arg "[pages]" var=#true help="Pages, unless --docs: a gate page (connections, dense/services, derived/<app>/<list>, the last filled with the longest values its model holds, as LongestValueLayoutTests fills it), a component catalog entry by its family and name (part/notice-error, form/filter-bar, table/figures, chart/line: a key of CATALOG in hq/platform/core/tests/browser/catalog.py, drawn as CatalogLayoutTests draws it; part/notice or table is every entry it begins), the page a refused form answers, by a POST of POSTS in hq/platform/core/tests/look_posts.py (post:project-create-blank, sent to the seed's estate as its page sends it), api/docs, estate/<path>, a path (/infrastructure/containers/, its leading slash optional), the last word of exactly one estate page's path (contacts), a route name (control_plane:containers), one record's page of the estate by the route that takes it (control_plane:detail, its first record the estate's pages link to) or the first page or component catalog entry that draws a template (template:control_plane/_container_detail.html, or template:_container_detail.html), estate/all (every estate page the layout gate reads: the navigation's, and a record's page of each kind the seed holds), or all (those, every gate page, every catalog entry, every named POST and api/docs). An estate page, a path or a route name takes a query as an address carries it (search/?q=hq is Command Center's results for hq). A name that is none is refused with the names to type instead, before the run waits for the heavy turn; a record's page by route or template is checked once the run draws the estate. Without --composed, a template no host directory holds or a route under a namespace the host lacks is refused as an extension's"
#USAGE flag "--docs" help="Redraw every screenshot in the docs from the showcase demo instead, after a change to a page one shows"
#USAGE flag "--widths <widths>" help="Comma-separated widths in CSS pixels; default the phone, 820 and 1360"
#USAGE flag "--rule <rule>" help="What to judge on each page: survey (every check the browser gates hold), tables (print each table) or one layout check by name, such as a_table_fits_its_box_at_every_width. Findings go to the run's report.txt, and no screenshot is taken unless --shots asks. A survey without --css keeps its verdict on the tree in var/gate/look-survey-<engine>.txt, which landing a page change reads"
#USAGE flag "--shots" help="With --rule, take the screenshots too: a run that judges reports its findings alone, unless --base, --eval or --operation, which read the shots, take them"
#USAGE flag "--css <css>" help="A stylesheet, as text or a file, laid over each page after its own sheets on every load, before the shot, --eval, --probe and --rule: a candidate fix or a planted defect, judged with no edit to static/css. It is adopted as a constructed sheet (document.adoptedStyleSheets), which the page's content security policy does not govern, where a <style> is refused; Playwright's bypass_csp would lift the whole policy, so the policy refusals the run reports would go unseen. A --base is drawn without it, so --base HEAD --css <file> --rule survey says what the sheet fixes and what it breaks"
#USAGE flag "--probe <probe>" help="Run one browser probe, <module>:<NAME> of hq/platform/core/tests/browser/probes/ (boxes:ASIDES_WRAPPED_WITH_ROOM), on each shot the look takes, as the survey runs it, and print what it finds beside the shot (.probe.txt): each finding on a line, or what it returns or throws. A name that is none is refused with those its module offers"
#USAGE flag "--arg <arg>" help="The argument --probe's function takes, as JSON: a selector is a quoted string ('\".section-head\"'), several a list; none is null"
#USAGE flag "--base <ref>" help="Also look at <ref> in a temporary worktree and report only findings and errors new or fixed here, its screenshots kept in base/ inside this run's folder; implies --rule survey and --perf, so it also measures the pages perf serves beside the base's. Both sides are judged by this checkout's probes, so a finding is new or fixed for what the pages draw, never for a change to a probe. Its verdict replaces the survey's in var/gate/look-survey-<engine>.txt, the one record per engine landing reads, and names only the pages it was asked, so a survey of templates a hand-back needs runs after it"
#USAGE flag "--perf" negate="--no-perf" help="Then measure with mise run perf the pages asked it serves, beside --base's, naming each it leaves out (a gate page, a record found by template or by the estate's links); on by default with --base"
#USAGE flag "--seed <name>" default="showcase" help="The data set the estate pages are drawn on, by its name in hq.platform.core.seeds"
#USAGE flag "--columns" help="Also print each table's column widths as drawn, at min-content and at max-content"
#USAGE flag "--eval <file>" help="Run the function in <file> on each shot the look takes, at each width, and print what it returns beside the shot: the page once --expand has opened its rows, each tag --open opens, each popover and each dialog, so it reads what each shot shows. An element it returns prints as the band file (.band-NN.png) that shows it; the page settles after it, so the shot draws what it changed"
#USAGE flag "--operation <operation>" help="On api/docs or api/docs/dark, open the one operation named by its method and path ('GET /api/v2/resources/projects/{identifier}/') before the shot: its tag shown, its body and every response opened with each property in them. An operation's #tag/ anchor in the page name lands on the introduction instead"
#USAGE flag "--dialog <ids>" help="Also shoot each page with these dialogs open, comma-separated ids or all; --rule runs again inside each. A dialog's region is asked of the seed's estate on any page, a gate page included, as a browser asks the server (--dialog connection connections)"
#USAGE flag "--engine <engine>" default="webkit" help="The browser engine to draw in, installed first" {
#USAGE   choices "webkit" "chromium" "firefox"
#USAGE }
#USAGE flag "--dark" help="In the dark palette"
#USAGE flag "--fallback-face" help="With Inter withheld, in the next face of the font stack"
#USAGE flag "--open" help="With every disclosure open; --rule runs again with one popover of each kind shown, and shoots it"
#USAGE flag "--open-folds" help="With --rule survey, judge each page again with every fold open, a fold within a fold and one a region brings in included, and say only what that adds; the folds close again before a dialog opens"
#USAGE flag "--expand" help="With every table row a reader can open opened: a row offers its toggle only when a value in it is cut, so a row that shows whole stays closed"
#USAGE flag "--no-script" help="As the server drew it, before any script runs"
#USAGE flag "--deep" help="Also every page the estate pages link to: each record and the command forms it opens"
#USAGE flag "--composed" help="With the extension set mise.local.toml names loaded, as mise run test --composed loads it, so estate/all and the route names reach the extensions' pages; its first line names the tree each is imported from, and HQ_LOCAL_PYTHONPATH on the command line composes an extension worktree instead. The extensions bring no data of their own: their pages draw empty beside the seed's estate"

# The look is hq/platform/core/tests/look.py; `mise run perf` measures after
# it, in the same heavy turn. The docs' pictures are demo/screenshot.py's, a
# step of its own (dev:look:docs) with the demo it draws from.
set -eu

if [ "${usage_docs:-}" = true ]; then
    exec mise run dev:look:docs
fi
[ -n "${usage_pages:-}" ] || { echo "mise run dev:look: name the pages to look at, or --docs" >&2; exit 64; }
# Composed, the extensions load as the composed suite loads them, which says
# first where they are imported from.
if [ "${usage_composed:-}" = true ]; then
    [ -n "${HQ_LOCAL_PLUGINS:-}" ] || {
        echo "mise run dev:look --composed: HQ_LOCAL_PLUGINS is unset; name the set with mise run setup:extensions <checkout>." >&2
        exit 64
    }
    # shellcheck source=tools/lib/extension-set.sh
    . ./tools/lib/extension-set.sh
    compose_extensions
    kept_set=/composed
fi

# A look at the pages it names holds a fraction of a suite's memory, so it
# runs beside other heavy work, as `mise run test` runs light labels; every
# page, every page linked, a base or a measure takes the heavy turn.
light_run=1
[ -z "${usage_base:-}" ] && [ "${usage_perf:-}" != true ] && [ "${usage_deep:-}" != true ] || light_run=""
# mise hands the pages over shell-quoted, one word each.
eval "set -- ${usage_pages:?}"
for page do
    case "${page}" in all | estate/all) light_run="" ;; esac
done
# What was asked is checked before the heavy turn, which may wait behind
# other runs: all but a record's page, found only in the estate the run draws.
uv run --group browser python manage.py shell --no-imports -v 0 \
    -c 'from hq.platform.core.tests.look import refuse_early; refuse_early()'
turn_bound=30m
# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh

# The test database outlives the run (Django's --keepdb), so the next run
# migrates only what is new. A run that did not come back to say it ended may
# have left its estate committed there, so the next one starts from a new
# file. A look against a base keeps none: the run at the base inherits this
# environment, and a database migrated here does not fit the code there. A
# composed look keeps its own, which holds the extensions' tables.
keep=""
if [ -z "${usage_base:-}" ]; then
    kept="${MISE_CONFIG_ROOT}/var/dev-look${kept_set:-}"
    mkdir -p "${kept}"
    [ ! -e "${kept}/running" ] || rm -f "${kept}"/test.sqlite3*
    : >"${kept}/running"
    SEVERINO_TEST_DATABASE_PATH="${kept}/test.sqlite3"
    export SEVERINO_TEST_DATABASE_PATH
    keep=--keepdb
fi

looked=0
# What the look prints is its output, which the test runner holds back for a
# test that passes unless told not to.
set -- uv run --group browser python manage.py test hq.platform.core.tests.look.Look.test_look --no-buffer \
    --noinput --parallel 1 ${keep}
# A survey of the tree runs under the gate verdict, kept per engine for the
# landing to read; one with a sheet laid over its pages judged more than the
# tree, so it keeps none.
survey=""
case "${usage_rule:-}" in
    survey) survey=1 ;;
    "") survey="${usage_base:+1}" ;;
esac
[ -z "${usage_css:-}" ] || survey=""
[ -z "${survey}" ] || set -- uv run python -m tools.gate.verdict "look-survey-${usage_engine:?}" "$@"
HQ_BROWSER_ENGINE="${usage_engine:?}" HQ_BROWSER_FACE="${usage_fallback_face:+fallback}" "$@" || looked=$?
[ -z "${keep}" ] || rm -f "${kept}/running"
eval "set -- ${usage_pages:?}"

case "${usage_perf:-}" in
    true) measure=1 ;;
    false) measure="" ;;
    *) measure="${usage_base:+1}" ;;
esac
[ -n "${measure}" ] || exit "${looked}"

# perf says which pages asked it cannot serve and measures the rest; its all
# is the estate's pages, never the gate pages dev:look's all adds.
for page do
    [ "${page}" != all ] || echo "mise run perf measures the estate's pages of all, not the gate pages"
done
measured=0
mise run perf "$@" --skip-unservable --seed "${usage_seed:?}" ${usage_base:+--base "${usage_base}"} || measured=$?
[ "${looked}" -ne 0 ] && exit "${looked}"
exit "${measured}"
