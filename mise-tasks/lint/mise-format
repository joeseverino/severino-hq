#!/bin/sh
#MISE description="mise.toml and the task files in mise-tasks/ are formatted as `mise fmt` writes them"
#MISE hide=true
#MISE tags=["fast"]
#MISE sources=["pyproject.toml", "uv.lock", "mise.toml", "mise.lock", "mise-tasks/*.toml", "tools/pipeline/toolchain.env"]
#MISE outputs=[]
#USAGE flag "--fix" help="Write each file as mise fmt does instead of checking: fast runs it first"

# Each file through stdin: `mise fmt --check` also judges the gitignored
# mise.local.toml, and never reads a task file. The list is mise.toml and
# every task file mise reads from mise-tasks/, written to a file so a failed
# find stops the run rather than handing the loop an empty list.
set -eu

files="$(mktemp)"
trap 'rm -f "${files}"' EXIT
echo mise.toml >"${files}"
find mise-tasks -name '*.toml' >>"${files}"
status=0
while IFS= read -r file; do
    if [ "${usage_fix:-}" = true ]; then
        formatted="$(mise fmt --stdin <"${file}")"
        printf '%s\n' "${formatted}" >"${file}"
    else
        # shellcheck disable=SC2094  # diff only reads the file it compares against
        mise fmt --stdin <"${file}" | diff -u "${file}" - || status=1
    fi
done <"${files}"
[ "${status}" -eq 0 ] || echo "lint:mise-format: mise run lint:mise-format --fix writes each file above as mise fmt does." >&2
exit "${status}"
