#!/bin/sh
#MISE description="Every shell file parses and passes shellcheck; the shell suites pass"
#MISE lock=["gate", "heavy"]
#MISE timeout="30m"
#MISE hide=true
set -eu
# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh
sources="$(tools/gate/shell-sources.sh)"
# A file that does not parse in the dialect its first line names fails shellcheck.
# shellcheck disable=SC2086  # one path per word
shellcheck -x $sources
exec mise run lint:shell:suites tests/shell/test-*.sh
