#!/bin/sh
#MISE description="Vale holds the wording to tools/lint/vale: no history in source, no em dash or hedged plural, none of HQ's own words on a page, no long or narrating sentence past the baseline"
#MISE hide=true
#MISE tags=["fast"]
#MISE sources=["**/*.py", "**/*.html", "**/*.md", "**/*.js", "**/*.css", "**/*.go", "**/*.sh", "tools/lint/vale/**", "pyproject.toml", "uv.lock", "mise.toml", "mise.lock", "mise-tasks/*.toml", "tools/pipeline/toolchain.env"]
#MISE outputs=[]
set -u

# Vale reads the tree into a JSON report; plain_words hands it the template
# attributes and tag literals it cannot read, and holds both to the baseline
# in hq/platform/core/prose_baseline.py, so one report names every finding.
report=$(mktemp) || exit 2
trap 'rm -f "$report"' EXIT
vale --config=tools/lint/vale/.vale.ini --output=JSON --glob='!{**/node_modules/**,**/vendor/**,**/__pycache__/**,**/*.gen.go}' \
	hq hq_sdk templates static controller tools tests demo deploy composition docs mise-tasks \
	AGENTS.md README.md CLAUDE.md manage.py entrypoint.sh >"$report"
status=$?
# 1 is findings, which plain_words reads; anything past it is Vale failing.
if [ "$status" -gt 1 ]; then
	cat "$report" >&2
	exit "$status"
fi
exec uv run python -m hq.platform.core.plain_words --tree "$report" templates
