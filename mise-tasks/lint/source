#!/bin/sh
#MISE description="The tests tagged source, which read the repository: a task, a workflow, a doc"
#MISE hide=true
#MISE extends="django"
#MISE env={SEVERINO_WAITS_FOR_HEAVY_TURN="1"}
#MISE depends=["setup:lint-tools"]
#USAGE arg "[labels]..." var=#true help="Test labels, dotted; only their tagged tests run. Every one by default"

# Tagged "source"; a whole-suite run leaves them out (hq/platform/core/test_runner.py),
# so no image or composed pass runs them. The stylesheet lint's tests run Stylelint.
set -eu

# A run of every source test takes the heavy turn; one its labels narrow to one
# process takes a share of it (tools/gate/turn.py).
test_arguments="--tag source --noinput --parallel auto ${usage_labels:-}"
turn_bound=30m
# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh

# mise hands the labels over shell-quoted, one word each.
eval "set -- ${usage_labels:-}"
exec uv run python manage.py test --tag source --noinput --parallel auto "$@"
