#!/bin/sh
#MISE description="CI job Tests, on every Python the matrix declares"
#MISE timeout="2h"

# One turn covers every interpreter's suite.
set -eu

repo="$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)"
# shellcheck source=tools/lib/heavy-turn.sh
. "${repo}/tools/lib/heavy-turn.sh"
cd "${repo}"

failed=0
# A pipeline leg names its one interpreter in TEST_PYTHONS.
for version in ${TEST_PYTHONS:-$PYTHON_VERSIONS}; do
    echo "[tests] Python $version"
    UV_PYTHON="$version" UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-.venv}-$version" \
        mise run -c 'tests:*' || failed=1
done
exit "$failed"
