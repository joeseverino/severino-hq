#!/bin/sh
#MISE description="The suite, the plugin contract, system checks, migrations and generated API cases: each tests:* gate on every Python the matrix declares"
#MISE timeout="2h"

# One turn covers every interpreter's suite.
set -eu

# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh

# A pipeline leg names its one interpreter in TEST_PYTHONS. Each interpreter's
# run is a step of one verdict, headed by its Python.
set --
for version in ${TEST_PYTHONS:-$PYTHON_VERSIONS}; do
    set -- "$@" --step "Python $version" env UV_PYTHON="$version" \
        UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-.venv}-$version" mise run -c 'tests:*'
done
exec uv run python -m tools.gate.verdict tests "$@"
