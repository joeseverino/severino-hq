#!/bin/sh
#MISE description="Each browser's first version that supports the features given, Safari first, with its release date and whether the browser floor has it, from @mdn/browser-compat-data; given none, every place the stylesheet writes a feature newer than the floor; read-only"
#MISE hide=true
#MISE extends="audit"
#MISE depends=["setup:lint-tools", "setup:sandbox"]
#USAGE arg "[features]" var=#true help="Feature paths as browser-compat-data names them, dotted (css.properties.field-sizing html.global_attributes.popover); a path that names a group says what it holds. None reads the stylesheet"

# tools/lint/bcd-audit.mjs reads the data the lint tools pin (Renovate moves
# it), so the answer is the same on every machine and offline once installed,
# and the floor is lint:css's own (tools/lint/browser-floor.mjs). The words
# are mise's shell-quoted parse of the arguments.
set -euf

eval "set -- ${usage_features:-}"
node tools/lint/bcd-audit.mjs "$@"
