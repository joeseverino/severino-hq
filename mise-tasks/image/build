#!/bin/sh
#MISE description="Build the production image as CI builds it, from this checkout's working tree as it stands (a base is measured with perf --base), and with --runner-tag the automation worker's image beside it; with IMAGE handing one over, only a daemon for its checks"
#MISE lock=["gate", "heavy"]
#MISE timeout="30m"
#MISE hide=true
#MISE depends_post=["image:docker stop"]
#USAGE flag "--tag <tag>" default="severino-hq:ci-local" help="The name to build it as"
#USAGE flag "--revision <commit>" help="The commit it is built for, HEAD by default; a pull request builds its head, not the merge it checks out"
#USAGE flag "--cache <ref>" help="A registry layer cache to read, ghcr.io/OWNER/REPO/build-cache:main in CI; a missing or unreadable one warns and builds cold"
#USAGE flag "--cache-write" help="Also write every stage's layers to --cache, as only main's Build cache job does"
#USAGE flag "--runner-tag <tag>" help="Also build the automation worker's image (the Dockerfile's runner stage) as this name, from the same tree and labeled the same; it reads --cache but never writes it"

# IMAGE names the image under test; the pipeline passes the one it built.
set -eu
# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh
# The VM boots once the turn is this task's, so it never waits idle for one.
mise run image:docker start
[ -z "${IMAGE:-}" ] || exit 0

# shellcheck source=tools/lib/source-url.sh
. ./tools/lib/source-url.sh
source="$(source_url)"
revision="${usage_revision:-$(git rev-parse HEAD)}"
# The security archive's release date keys the layer that applies Debian's
# fixes, so a cached layer is reused until Debian publishes. Unreachable, the
# day keys it instead: rebuilt at most daily. The Debian release is the one
# the runtime stage is built on.
codename="$(sed -nE 's/^FROM python:[^@]*-slim-([a-z]+)@.* AS runtime$/\1/p' Dockerfile)"
security_release="$(curl -fsSL --retry 3 "https://deb.debian.org/debian-security/dists/${codename}-security/InRelease" 2>/dev/null \
    | sed -n 's/^Date: //p' || true)"
if [ -z "$security_release" ]; then
    security_release="$(date -u +%F)"
    echo "::warning title=Debian security date unknown::deb.debian.org did not answer; the upgrade layer is keyed on ${security_release} instead."
fi
# A cache entry maps a step to a layer on its writer's word, so only main's
# Build cache job writes one; every build may read it. mode=max keeps the
# intermediate stages (the Go build, the dependency install), which the final
# image holds only the outputs of.
set --
if [ -n "${usage_cache:-}" ]; then
    set -- --cache-from "type=registry,ref=${usage_cache}"
    [ "${usage_cache_write:-}" != true ] || set -- "$@" --cache-to "type=registry,ref=${usage_cache},mode=max"
elif [ "${usage_cache_write:-}" = true ]; then
    echo "--cache-write needs --cache" >&2
    exit 2
fi
# The source label is the standard OCI one: GHCR links the package to this
# repository by it, and the controller reads which repository delivers it from
# the image it runs. The tree label is what a push to main compares to promote
# an image proven on its pull request (tools/pipeline/proven-on-pr.sh).
tree="$(git rev-parse 'HEAD^{tree}')"
docker buildx build --load "$@" \
    --label "org.opencontainers.image.source=$source" \
    --label "org.opencontainers.image.revision=$revision" \
    --label "dev.severino.hq.tree=$tree" \
    --build-arg "HQ_SOURCE=$source" \
    --build-arg "HQ_REVISION=$revision" \
    --build-arg "DEBIAN_SECURITY_RELEASE=$security_release" \
    -t "${usage_tag:?}" .
[ -n "${usage_runner_tag:-}" ] || exit 0

# The worker's image carries the same labels, so GHCR links it to this
# repository and a push to main promotes it by the same tree. A registry cache
# holds one build's layers, and a second --cache-to would replace the web
# image's with these, so it only reads; the stages the two share (the lock,
# the base) come from the build above.
set --
[ -z "${usage_cache:-}" ] || set -- --cache-from "type=registry,ref=${usage_cache}"
docker buildx build --load "$@" --target runner \
    --label "org.opencontainers.image.source=$source" \
    --label "org.opencontainers.image.revision=$revision" \
    --label "dev.severino.hq.tree=$tree" \
    --build-arg "DEBIAN_SECURITY_RELEASE=$security_release" \
    -t "${usage_runner_tag}" .
