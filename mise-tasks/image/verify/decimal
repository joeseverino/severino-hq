#!/bin/sh
#MISE description="Its decimal is the C module on libmpdec, not the pure-Python fallback"
#MISE lock=["gate", "heavy"]
#MISE timeout="30m"
#MISE hide=true
#MISE depends=["image:build"]
#MISE depends_post=["image:docker stop"]
set -eu
# shellcheck source=tools/lib/heavy-turn.sh
. ./tools/lib/heavy-turn.sh
# A Python built without libmpdec still imports decimal, as _pydecimal, which
# runs money arithmetic many times slower; only _decimal says which one it got.
docker run --rm --entrypoint python "${IMAGE:-severino-hq:ci-local}" -c \
    "import decimal, _decimal; print('decimal runs on libmpdec', decimal.__libmpdec_version__)"
