#!/bin/sh
#MISE description="It carries the host programs, which refuse to run unprivileged"
#MISE hide=true
#MISE depends=["image:build"]
set -eu

image="${IMAGE:-severino-hq:ci-local}"
# The image's user is not root, so each must refuse and say why.
for command in hq-secrets "hq-host verify"; do
    program="${command%% *}"
    # shellcheck disable=SC2086  # the command's argument is meant to split off
    if said="$(docker run --rm --entrypoint "/app/deploy/bin/$program" "$image" ${command#"$program"} 2>&1)"; then
        echo "$program ran as an unprivileged user." >&2
        exit 1
    fi
    case "$said" in
        *"$program must run as root."*) ;;
        *) echo "$program: $said" >&2; exit 1 ;;
    esac
done
