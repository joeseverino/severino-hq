#!/bin/sh
#MISE description="It cannot import development layers and ships no development programs"
#MISE hide=true
#MISE depends=["image:build"]
set -eu

image="${IMAGE:-severino-hq:ci-local}"
docker run --rm --entrypoint python "$image" -c \
    "import importlib.util, sys; sys.exit(importlib.util.find_spec('debug_toolbar') is not None)"

# tools/ is development and CI, and the host's tree is hq/config and deploy
# alone: a program under scripts/ or tools/ is one nothing in the image runs.
shipped="$(docker run --rm --entrypoint sh "$image" -c \
    'cd /app && find scripts tools 2>/dev/null | sort')"
if [ -n "$shipped" ]; then
    echo "The image ships, under scripts/ and tools/, what it should not:" >&2
    printf '%s\n' "$shipped" >&2
    exit 1
fi
