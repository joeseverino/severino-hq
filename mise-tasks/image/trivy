#!/bin/sh
#MISE description="Trivy over an image, as Compose scans the composed one: fixable HIGH and CRITICAL fail"
#MISE hide=true
#USAGE arg "[image]" help="The image to scan; without one, the host image is built and scanned"

# The Trivy mise.toml pins, which Compose scans with too, with its flags.
set -eu

image="${usage_image:-}"
if [ -z "${image}" ]; then
    image="severino-hq:trivy"
    mise run image:build --tag "${image}"
fi
trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --format table "${image}"
