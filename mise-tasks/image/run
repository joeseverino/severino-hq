#!/bin/sh
#MISE description="Run one command in a built image, holding the Docker VM until it ends"
#MISE lock="heavy"
#MISE timeout="30m"
#MISE depends_post=["image:docker stop"]
#USAGE arg "<command>..." var=#true double_dash="automatic" help="The command and its arguments, run as the image's entrypoint"
#USAGE flag "--image <image>" help="The image to run; severino-hq:ci-local by default"
set -eu
# The VM is started here, so the depends_post stop is this run's own and
# another worktree's stop leaves the VM up while this command runs.
mise run image:docker start
eval "set -- ${usage_command:?}"
entrypoint="$1"
shift
exec docker run --rm --entrypoint "${entrypoint}" "${usage_image:-${IMAGE:-severino-hq:ci-local}}" "$@"
