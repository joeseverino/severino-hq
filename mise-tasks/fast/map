#!/bin/sh
#MISE description="The map of the tests that ran each line, which fast selects from: the whole suite, as fast runs it, measured with a context per test and one per test module's fixtures, read back by module; CI's Map workflow runs it in shares (tools/gate/testmap.py), and audit:tests reads the same recording"
#MISE hide=true
#MISE outputs=[]
#USAGE flag "--share <share>" env="HQ_MAP_SHARE" help="Record only this share of the test modules, i/n, chosen as a browser gate's shares are, and leave the map to --write"
#USAGE flag "--write" help="Write the map from the recordings under var/coverage/map, every share's combined"

# Its contexts make the run much slower, so only CI's Map workflow,
# which nothing waits on, records: never a gate.
set -eu
if [ "${usage_write:-}" = true ]; then
    exec uv run python -m tools.gate.testmap
fi
# This share's test modules, as fast labels them; every module with no share asked.
labels="$(uv run python -c '
import sys
from hq.platform.core.tests.browser.shards import VARIABLE, runs_here, shard
from tools.gate import selection
at = shard({VARIABLE: sys.argv[1]})
print(" ".join(m for m in selection.whole_suite(selection.python_files()) if runs_here(m, at)))
' "${usage_share:-}")"
# shellcheck disable=SC2086 # one label a word
mise run fast:tests --map "$PWD/var/coverage/map/data" $labels
[ -n "${usage_share:-}" ] || exec uv run python -m tools.gate.testmap
