#!/bin/sh
#MISE description="fast's look at the catalog entries the stylesheets and templates a change touched reach, each surveyed with script and without in WebKit: mise run fast"
#MISE hide=true
#MISE extends="django"
#MISE tags=["fast", "heavy"]
#MISE sources=["static/css/app/*.css", "templates/**/*.html"]
#MISE outputs=[]
#USAGE arg "[files]..." var=#true help="The files the change touched, as fast hands them: the catalog entries each stylesheet and template among them reaches are looked at (tools/gate/look_entries.py); a file that reaches every entry, and none handed, leave the catalog to CI's Browser job"

# In fast's share of the heavy turn, beside its tests (tools/gate/fast.py,
# heavy_gates), at the narrowest and widest widths the catalog's gate judges
# an entry at (widths.SPARSE_WIDTHS), in the engine HQ is read in. fast sets
# HQ_FAST_BASE, the ref each sheet's change is read from.
set -eu
# mise hands the words over shell-quoted, one word each.
eval "set -- ${usage_files:-}"
for path do
    shift
    case "${path}" in
        # Its sources' stylesheets and templates, never another .html (a page
        # rendered from them, such as the inbound-events Worker's).
        static/css/*.css | templates/*.html) set -- "$@" "${path}" ;;
    esac
done
if [ "$#" -eq 0 ]; then
    echo "fast:look: no stylesheet or template was handed, so no entry is looked at"
    exit 0
fi
entries="$(uv run python -m tools.gate.look_entries "$@")"
set --
while IFS= read -r entry; do
    [ -z "${entry}" ] || set -- "$@" "${entry}"
done <<EOF
${entries}
EOF
if [ "$#" -eq 0 ]; then
    echo "fast:look: no catalog entry is left to look at"
    exit 0
fi
# Surveyed as the catalog's two sweeps judge an entry: once its script has
# run (its folds and rows open, its tables at every width) and as the server
# drew it (its popovers shown). The look's own mise runs read the checkout's
# config alone.
status=0
env -u MISE_ENV mise run dev:look --rule survey --widths 320,1280 --engine webkit "$@" || status=$?
env -u MISE_ENV mise run dev:look --rule survey --no-script --widths 320,1280 --engine webkit "$@" || status=$?
exit "${status}"
