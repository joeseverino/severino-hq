#!/bin/sh
#MISE description="When a lint or format gate fails: write Ruff's fixes and format, and mise fmt's format of the task files"

# The same file set the two gates read, so a fix run leaves them nothing to
# report.
set -eu
# shellcheck source=tools/lib/mise-files.sh
. ./tools/lib/mise-files.sh

uv run ruff check --fix .
uv run ruff format .
files="$(mktemp)"
trap 'rm -f "${files}"' EXIT
mise_files "${files}"
while IFS= read -r file; do
    formatted="$(mise fmt --stdin <"${file}")"
    printf '%s\n' "${formatted}" >"${file}"
done <"${files}"
