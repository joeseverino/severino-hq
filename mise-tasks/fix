#!/bin/sh
#MISE description="Write what checks:ruff and checks:mise-format hold: Ruff's fixes and format, and mise.toml and its task files as mise fmt writes them"

# The same file set the two gates read, so a fix run leaves them nothing to
# report.
set -eu

uv run ruff check --fix .
uv run ruff format .
files="$(mktemp)"
trap 'rm -f "${files}"' EXIT
echo mise.toml >"${files}"
find mise-tasks -name '*.toml' >>"${files}"
while IFS= read -r file; do
    formatted="$(mise fmt --stdin <"${file}")"
    printf '%s\n' "${formatted}" >"${file}"
done <"${files}"
