#!/bin/sh
#MISE description="gitleaks finds no secret in a repository's commits: those a push or pull request brings in CI, the whole history otherwise"
#MISE timeout="10m"
#MISE hide=true
#USAGE arg "[repository]" default="." help="The checkout to scan, this one by default; the extensions' plugin checks name theirs"

# The secret scan the extensions' plugin checks run (plugin-checks.yml), with
# the gitleaks mise.lock checksums. The commits are those gitleaks-action
# chose: a push's, from the event's first commit to its last, and a pull
# request's, from its base to its head, each along first parents without
# merges; any other run, or a run outside CI, reads the whole history. The
# scan runs from inside the checkout, so its own .gitleaks.toml and
# .gitleaksignore apply, and every secret is redacted from the output.
set -eu

cd "${usage_repository:?}"
event="${GITHUB_EVENT_PATH:-}"
set --
case "${GITHUB_EVENT_NAME:-}" in
    push)
        if [ "$(jq '.commits | length' "${event}")" -eq 0 ]; then
            echo "[secrets] the push brings no commit"
            exit 0
        fi
        first="$(jq -r '.commits[0].id' "${event}")"
        last="$(jq -r '.commits[-1].id' "${event}")"
        if [ "${first}" = "${last}" ]; then
            set -- --log-opts="-1 ${last}"
        else
            set -- --log-opts="--no-merges --first-parent ${first}^..${last}"
        fi
        ;;
    pull_request)
        base="$(jq -r '.pull_request.base.sha' "${event}")"
        head="$(jq -r '.pull_request.head.sha' "${event}")"
        set -- --log-opts="--no-merges --first-parent ${base}..${head}"
        ;;
esac
gitleaks git --no-banner --redact --verbose "$@" .
