#!/bin/sh
#MISE description="CodeQL, security-and-quality: no alerts"
#MISE hide=true

# What CI's CodeQL job runs, before pushing rather than after merging: the
# bundle mise.toml pins (checks:codeql-bundle holds it to the action), the
# security-and-quality suite, and the paths and rules
# .github/codeql/codeql-config.yml leaves out. It reads an export of the files
# git would push, so a local .venv or stray build output is not scanned.
set -eu

# shellcheck source=tools/lib/export-tree.sh
. ./tools/lib/export-tree.sh

work="$(scan_tree codeql)"
src="${work}/src"
# The export and the database are rebuilt on every run, and the database alone
# is hundreds of megabytes; codeql.sarif holds the findings.
trap 'rm -rf "${src}" "${work}/codeql-db"' EXIT

echo "[codeql] CodeQL $(codeql version --format=terse) database"
# `--build-mode none` is what the Action uses for Python: nothing is compiled,
# so the extractor reads the tree directly.
codeql database create "${work}/codeql-db" \
    --language=python \
    --build-mode=none \
    --source-root="${src}" \
    --codescanning-config="${src}/.github/codeql/codeql-config.yml" \
    --threads=0 --quiet \
    --overwrite >/dev/null

echo "[codeql] analysis (security-and-quality)"
codeql database analyze "${work}/codeql-db" \
    --format=sarif-latest \
    --output="${work}/codeql.sarif" \
    --sarif-category=/language:python \
    --threads=0 --quiet \
    codeql/python-queries:codeql-suites/python-security-and-quality.qls >/dev/null

# The analysis reports what the config's query filters drop; the report drops
# the same rules.
excludes=""
for rule in $(yq '.query-filters[].exclude.id | select(. != null)' .github/codeql/codeql-config.yml); do
    excludes="${excludes} --exclude ${rule}"
done
# shellcheck disable=SC2086  # a rule id is one word
uv run python -m tools.pipeline.codeql_report "${work}/codeql.sarif" ${excludes}
echo "[codeql] clean"
