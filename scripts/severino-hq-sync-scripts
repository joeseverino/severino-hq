#!/bin/sh
# severino-hq-sync-scripts: populate /usr/local/lib/severino-hq, the tree that
# root-run Severino HQ units execute, and prove it is the tree the image shipped.
#
#   severino-hq-sync-scripts                   # from the running container's image
#   severino-hq-sync-scripts --from-checkout   # from /opt/apps/severino-hq (UNTRUSTED)
#
# The image source is preferred because its content is fixed by digest and was
# cosign-verified by the deploy. The checkout is writable by an unprivileged
# account, so syncing from it lets that account choose what root runs.
#
# The deploy runs the copy of this program inside the image it is installing
# and then installs that copy at /usr/local/sbin, so the program that syncs a
# release is always that release's own.
#
# What must be present is not listed here. The image build writes
# root-tree.sha256 (scripts/root-tree-manifest.sh) and the synced tree must
# reproduce it exactly: every file, byte for byte, and nothing else. Every
# path under the tree that a shipped unit names must exist as well.
set -eu

LIB="${SEVERINO_HQ_LIB_DIR:-/usr/local/lib/severino-hq}"
# The path units name, whatever LIB is relocated to.
readonly UNIT_LIB=/usr/local/lib/severino-hq
readonly MANIFEST=root-tree.sha256
CONTAINER="${HQ_CONTAINER:-severino-hq}"
APP_DIR="${SEVERINO_HQ_APP_DIR:-/opt/apps/severino-hq}"
SOURCE=image
[ "${1:-}" = "--from-checkout" ] && SOURCE=checkout

[ "$(id -u)" -eq 0 ] || { echo "must run as root" >&2; exit 1; }

stage="$(mktemp -d "${LIB%/*}/.severino-hq-sync.XXXXXX")"
cid=""
moved=0
cleanup() {
    [ -n "$cid" ] && docker rm -f "$cid" >/dev/null 2>&1 || true
    [ "$moved" -eq 0 ] && rm -rf "$stage" || true
}
trap cleanup EXIT HUP INT TERM

abort() { echo "sync aborted: $*" >&2; exit 1; }

mkdir -p "$stage/hq"

if [ "$SOURCE" = image ]; then
    image_id="$(docker inspect --format '{{.Image}}' "$CONTAINER")"
    [ -n "$image_id" ] || abort "could not resolve the running image"
    cid="$(docker create "$image_id" true)"
    for item in scripts hq/config deploy docker-compose.yml "$MANIFEST"; do
        docker cp "$cid:/app/$item" "$stage/$item" || abort "the image ships no /app/$item"
    done
    docker rm -f "$cid" >/dev/null; cid=""
    provenance="image $image_id"
else
    echo "WARNING: syncing from ${APP_DIR}, which is writable by an" >&2
    echo "WARNING: unprivileged user. Root will execute whatever is there." >&2
    for item in scripts hq/config deploy docker-compose.yml; do
        cp -a "$APP_DIR/$item" "$stage/$item"
    done
    sh "$APP_DIR/scripts/root-tree-manifest.sh" "$APP_DIR" >"$stage/$MANIFEST"
    provenance="checkout $(git -C "$APP_DIR" rev-parse HEAD 2>/dev/null || echo unknown)"
fi

# Everything root owns; nothing group- or world-writable.
chown -R root:root "$stage"
find "$stage" -type d -exec chmod 0755 {} +
find "$stage" -type f -exec chmod 0644 {} +
find "$stage" -type f -name '*.sh' -exec chmod 0755 {} +

[ -s "$stage/$MANIFEST" ] || abort "$MANIFEST is empty"
if ! sh "$stage/scripts/root-tree-manifest.sh" "$stage" | cmp -s - "$stage/$MANIFEST"; then
    abort "the synced tree does not reproduce $MANIFEST"
fi

# Every path under the tree that a shipped unit names, derived from the units.
find "$stage/deploy/systemd" -type f ! -name '*.example' | while IFS= read -r unit; do
    for path in $(grep -o "${UNIT_LIB}/[A-Za-z0-9_./-]*" "$unit" || true); do
        [ -e "$stage/${path#"${UNIT_LIB}"/}" ] \
            || abort "${unit#"$stage"/} names ${path}, which the tree does not ship"
    done
done

printf '%s\n' "$provenance"           > "$stage/.source"
date -u +%Y-%m-%dT%H:%M:%SZ           > "$stage/.synced-at"
chmod 0644 "$stage/.source" "$stage/.synced-at"

# Swap on the same filesystem.
old=""
if [ -d "$LIB" ]; then old="${LIB}.old.$$"; mv "$LIB" "$old"; fi
mv "$stage" "$LIB"; moved=1
[ -n "$old" ] && rm -rf "$old"
echo "synced $LIB from ${provenance}"
