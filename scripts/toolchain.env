scripts/check.sh
scripts/check-fast.sh
scripts/check-openapi.sh
scripts/generate-clients.sh
scripts/ci-local.sh
scripts/dev.sh
controller/scripts/check.sh
entrypoint.sh
deploy/targets/severino-hq-edge-controller
deploy/targets/severino-hq-edge-dispatch"

