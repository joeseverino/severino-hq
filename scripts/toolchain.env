# The toolchain, declared once. Read by the `toolchain` action (which re-emits
# the matrix as JSON), by the plugin admission action and by
# `scripts/ci-local.sh`, so a local run and a pipeline run use the same tools.
#
# Shell syntax because everything that reads it is shell. The README badges are
# static markdown and cannot be generated from this, so CI verifies them against
# it instead.

# ruff, mypy, coverage and uv are pip-installed, so their pins live once, hashed, in
# requirements-tools.txt (compiled from requirements-tools.in). Read from there,
# relative to the repository root, where every reader runs.
RUFF_VERSION=$(sed -n 's/^ruff==\([^ ]*\).*/\1/p' requirements-tools.txt)
MYPY_VERSION=$(sed -n 's/^mypy==\([^ ]*\).*/\1/p' requirements-tools.txt)
# An unpinned linter makes the local gate and the pipeline disagree, and the
# local one is the one that gets trusted.
SHELLCHECK_VERSION=0.11.0
ACTIONLINT_VERSION=1.7.12
# The Go controller's toolchain is its go.mod's go directive, which setup-go
# also reads (go-version-file), so the pin lives once, in controller/go.mod.
GO_VERSION=$(sed -n 's/^go \([0-9.]*\)$/\1/p' controller/go.mod)
# SHA-256 of each Linux release archive, checked before it is unpacked.
# actionlint's matches its published checksums.txt; shellcheck publishes none.
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
# The Cordon commit whose admission tools sign and verify extension wheels:
# the admission action and Compose read this one pin.
CORDON_COMMIT=a5f2f2d2c11e33abe1be6ab04e5961f3c2f4a739
# Compose seals the full output of a failed run to this public key before
# uploading it (scripts/seal-failure-logs.sh); only the operator's identity
# opens it (scripts/failure-logs.sh). A post-quantum hybrid key (ML-KEM-768 +
# X25519): the sealed logs are public to download and keep. age publishes no
# checksums file.
AGE_VERSION=1.3.2
AGE_SHA256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
FAILURE_LOG_
# The code graph the structural bar indexes with (scripts/structural-bar.sh).
CODEBASE_MEMORY_MCP_VERSION=0.10.8
# Digests are the release's published checksums; Linux takes the portable
# (static) build so the runner needs no matching libc.
CODEBASE_MEMORY_MCP_SHA256_DARWIN_ARM64=9bd840dfb3ec7eaef4f310382057adaa5b0e904df883104d03ffcf39836afd07
CODEBASE_MEMORY_MCP_SHA256_DARWIN_AMD64=2b193085410af3801634a522f4b17dcd6699695e015a068393c87817c1d260d4
CODEBASE_MEMORY_MCP_SHA256_LINUX_AMD64=6eef49652bc0c7820f43114125044d40bf7f4d97c11b2592f6b0f6a307702325
CODEBASE_MEMORY_MCP_SHA256_LINUX_ARM64=5697d986d9716c913163b4bff7b3a294287f3b843e993bc1ff71e78dcdc21781
# The CodeQL bundle the pinned github/codeql-action defaults to (its
# src/defaults.json), so the local analysis runs the queries CI runs. Bump with
# that action. Digests are the release's published .checksum.txt values.
CODEQL_VERSION=2.26.4
CODEQL_SHA256_OSX64=546ab3318398602ca1861253ea3b772a3f76512476938e8f03a0c0adf07e0ef7
CODEQL_SHA256_LINUX64=a9872c9075f85374a8d03546263c6dc01fde50a29baea9fc08dcc6b25cc2efd5
# The Scorecard the pinned ossf/scorecard-action builds against (its go.mod).
# Digests from the release's scorecard_checksums.txt.
SCORECARD_VERSION=5.5.0
SCORECARD_SHA256_DARWIN_ARM64=bac6371a4f810d6bdd0b65d63c3311906bdfe3ba0d76a5ea743ce24ced170fcf
SCORECARD_SHA256_DARWIN_AMD64=979487ca20e726f6a4d2bd63a0a4c544184f589724b3d12d2ba8d0ea80889063
SCORECARD_SHA256_LINUX_AMD64=83b90a05c1540ef1390db1cd5711e5fd04be9c1d8537fb84d39d02092d6a8dff
SCORECARD_SHA256_LINUX_ARM64=3ce59d20c1d53e540c4a14e0da1e0d96b3b294e8ddc96a3c5a7b8a637b32991e
# The GitHub-hosted runner image, pinned for the reason the tools are: an
# unpinned `ubuntu-latest` moves on GitHub's schedule, so the build machine
# would change without a commit saying so.
# Workflow YAML cannot read this file, so CI verifies every hosted job against it.
RUNNER_IMAGE=ubuntu-24.04
PIP_AUDIT_VERSION=2.10.1

# Every interpreter the suite must pass on. Oldest first; the oldest is the one
# whose coverage total the README badge quotes.
PYTHON_VERSIONS="3.13 3.14"

# The floor, not the target. The measured number is higher and the README badge
# states it exactly; this is the point below which the build fails.
COVERAGE_FLOOR=70

# Shell sources checked by `sh -n`/`bash -n` and shellcheck.
SHELL_SOURCES="scripts/coverage-badge.sh scripts/image-health.sh scripts/failed-step.sh scripts/composed-suite.sh scripts/seal-failure-logs.sh scripts/failure-logs.sh scripts/proven-on-pr.sh scripts/test-proven-on-pr.sh scripts/job-log.sh scripts/retag.sh scripts/test-retag.sh
scripts/hq-verdict.sh
