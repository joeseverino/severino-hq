# Facts about the pipeline that are not tools, declared once. mise loads this
# file (mise.toml), and shell and the workflow actions source it. Plain
# KEY=value: both a shell and a dotenv reader must be able to read it.
#
# Tool versions and their checksums live in mise.toml and mise.lock; Python
# pins in pyproject.toml and uv.lock; Go's in controller/go.mod.

# The Cordon commit whose admission tools sign and verify extension wheels:
# the admission action and Compose read this one pin.
CORDON_COMMIT=a5f2f2d2c11e33abe1be6ab04e5961f3c2f4a739

# Compose seals the full output of a failed run to this public key before
# uploading it (scripts/seal-failure-logs.sh); only the operator's identity
# opens it (scripts/failure-logs.sh). A post-quantum hybrid key (ML-KEM-768 +
# X25519): the sealed logs are public to download and keep.
FAILURE_LOG_

# The GitHub-hosted runner image, pinned for the reason the tools are: an
# unpinned `ubuntu-latest` moves on GitHub's schedule. Workflow YAML cannot
# read this file, so `checks:runners` holds every hosted job to it.
RUNNER_IMAGE=ubuntu-24.04

# Every interpreter the suite must pass on.
PYTHON_VERSIONS="3.14"

# The point below which the build fails, and the number the README badge
# states. Raise it on purpose; a run that measures higher changes nothing.
COVERAGE_FLOOR=90
