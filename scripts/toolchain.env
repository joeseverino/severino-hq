# The toolchain, declared once. Read by `.github/workflows/ci.yml` (the
# `toolchain` job, which re-emits the matrix as JSON) and by
# `scripts/ci-local.sh`, so a local run and a pipeline run use the same tools.
#
# Shell syntax because everything that reads it is shell. The README badges are
# static markdown and cannot be generated from this, so CI verifies them against
# it instead.

# Pinned so a lint failure means the code changed, not the linter.
RUFF_VERSION=0.15.18

# Every interpreter the suite must pass on. Oldest first; the oldest is the one
# whose coverage total the README badge quotes.
PYTHON_VERSIONS="3.12 3.13 3.14"

# The floor, not the target. The measured number is higher and the README badge
# states it exactly; this is the point below which the build fails.
COVERAGE_FLOOR=70

# Shell sources checked by `sh -n`/`bash -n` and shellcheck.
SHELL_SOURCES="scripts/deploy-image.sh
scripts/install-controller.sh
scripts/controller-ssh.sh
scripts/provision-controller-ssh.sh
scripts/refresh-secrets.sh
scripts/render-controller-env.sh
scripts/run-controller.sh
scripts/test-render-controller-env.sh
scripts/test-edge-controller.sh
scripts/test-deploy-image.sh
scripts/test-backup.sh
scripts/backup.sh
scripts/check.sh
scripts/ci-local.sh
scripts/dev.sh
entrypoint.sh
deploy/targets/severino-hq-edge-controller
deploy/targets/severino-hq-edge-dispatch
deploy/targets/severino-hq-cpanel-controller"

# Shell suites CI executes (not merely parses).
SHELL_SUITES="scripts/test-render-controller-env.sh
scripts/test-edge-controller.sh
scripts/test-deploy-image.sh
scripts/test-backup.sh"
