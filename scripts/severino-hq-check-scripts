#!/bin/sh
# Fails when the root-owned script tree no longer matches the image production
# is running, or when an installed systemd file no longer matches the one that
# tree ships.
set -eu
LIB=/usr/local/lib/severino-hq
SYSTEMD_DIR=/etc/systemd/system
rc=0

if [ ! -f "$LIB/.source" ]; then
    echo "drift: $LIB/.source missing -- the root tree was never synced" >&2
    exit 1
fi
recorded="$(sed -n 's/^image //p' "$LIB/.source")"
current="$(docker inspect --format '{{.Image}}' severino-hq 2>/dev/null || echo '')"
# Not being able to read the running image is not agreement. This used to fall
# through to "current" whenever docker was unreachable or the container was
# absent -- the two situations in which a drift check matters most.
if [ -z "$current" ]; then
    echo "drift: could not read the running image; cannot confirm the root tree" >&2
    rc=1
elif [ -n "$recorded" ] && [ "$recorded" != "$current" ]; then
    echo "drift: root scripts came from $recorded; production now runs $current" >&2
    echo "drift: run 'severino-hq-sync-scripts' as root to resync" >&2
    rc=1
fi

# Every unit and drop-in the tree ships, byte for byte against its installed
# copy. This compared the ExecStart basename of three units and nothing else, so
# a unit the installer never installed, or installed once and never again, was
# drift nobody could see: the host ran stale copies of five shipped files with
# this check green. The set is the installer's own, from the same library, so
# the two cannot disagree about what "shipped" means.
#
# Read from the root tree, which the check above has just tied to the running
# image, rather than from the deploy checkout anyone who deploys can write.
# shellcheck source=scripts/lib/systemd-units.sh
. "$LIB/scripts/lib/systemd-units.sh"
if ! drifted="$(units_drifted "$LIB/deploy/systemd" "$SYSTEMD_DIR")"; then
    echo "drift: could not list the shipped units; cannot confirm the installed ones" >&2
    rc=1
elif [ -n "$drifted" ]; then
    for f in $drifted; do
        echo "drift: $SYSTEMD_DIR/$f does not match $LIB/deploy/systemd/$f" >&2
    done
    echo "drift: install-controller.sh installs the shipped set; the next deploy runs it" >&2
    rc=1
fi

[ "$rc" -eq 0 ] && echo "root-owned script tree and systemd units are current"
exit "$rc"
