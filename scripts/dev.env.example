# Copy to `.env.dev` in the repository root. That path is gitignored.
#
# Without it, `scripts/check.sh` skips its third pass and `scripts/ci-local.sh`
# skips the extension-identifier check -- the two gates that need to know an
# extension set exists. Neither failure is loud, which is the reason this file
# exists: a gate that quietly covers less is worse than one that fails.
#
# Nothing here is committed, so the host can be told where extensions live
# without any of it entering the source. The values below are the synthetic
# `example.*` namespace; substitute your own checkouts.
#
# Every line uses `: "${NAME:=value}"` — assign only if unset — so an explicit
# environment variable on the command line still wins over the file.

# An interpreter that can import the extensions. This repository's own .venv
# deliberately cannot: the extensions are not a dependency of the host.
: "${CHECK_PYTHON:=$HOME/.venvs/severino-hq-dev/bin/python}"

# Where their sources are. The host checkout comes first.
: "${PYTHONPATH:=$PWD:$HOME/code/example-alpha/src:$HOME/code/example-beta/src}"

# Which to enable, as `module:attribute`, comma separated.
: "${SEVERINO_HQ_PLUGINS:=example_alpha.plugin:plugin,example_beta.plugin:plugin}"

# Optional. Interpreters `scripts/ci-local.sh` runs the suite against, space
# separated. CI uses a 3.12/3.13/3.14 matrix; each needs the pinned
# requirements installed, so these are paths rather than version numbers.
# : "${SEVERINO_CI_PYTHONS:=$HOME/.venvs/hq312/bin/python .venv/bin/python}"
