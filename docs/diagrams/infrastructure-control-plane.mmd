flowchart LR
    operator["Operator<br/>Web · CLI · MCP"] --> services["HQ application services"]
    topology["Severino Labs topology<br/>authored identities + dependency edges"] --> snapshot[("Trusted topology snapshot<br/>validated + checksummed")]
    snapshot --> resolver["Topology projection resolver"]
    resolver --> services
    services --> desired[("ManagedResource<br/>desired state + generation")]
    services --> queue[("OperationRequest<br/>idempotency + lease")]

    controller["Privileged homelab controller<br/>systemd · exact-image exec · filtered apply"] -->|peek or lease desired-only JSON| queue
    queue -->|resolved resource contract| controller
    controller -->|active| adguard["AdGuard rewrite adapter"]
    controller -->|active| npm["Nginx Proxy Manager adapter"]
    controller -->|observe active| tlsobserve["TLS consumer observer"]
    controller -.->|renew locked| tls["TLS renewal automation"]
    controller -.->|capability locked| publicdns["Public DNS adapter"]
    tls --> cf["Cloudflare DNS-01"]
    tlsobserve --> npm
    tlsobserve --> caddy
    tls --> npm
    tls --> caddy["Caddy"]
    tls --> cpanel["Namecheap cPanel"]

    controller -->|public status + conditions| desired
    desired --> ui["HQ health, drift, downloads, audit"]

    secrets["Severino HQ Production<br/>runtime projections"] -.-> controller
    secrets -. "web-only projection" .-> services

    classDef store fill:#e8f2f3,stroke:#1f5d63,color:#153d41
    classDef boundary fill:#f6f1e7,stroke:#8a6d3b,color:#4b3b20
    class desired,queue store
    class secrets boundary
