flowchart TB
    subgraph inputs["Declared inputs"]
        direction LR
        operator["Operator<br/>Web · hq · MCP"]
        topology["Severino Labs topology<br/>identities + dependencies"]
        secrets["Severino HQ Production<br/>runtime credentials"]
    end

    topology --> snapshot[("Trusted topology snapshot<br/>validated + checksummed")]
    snapshot --> resolver["Provider-owned resolution<br/>authored → runtime schema"]
    operator --> services["HQ application services"]
    resolver --> services

    services --> desired[("Managed resources<br/>desired generation + health")]
    services --> queue[("Operation queue<br/>idempotency + lease")]

    queue <-->|"minimal resolved contract<br/>public result"| controller["Privileged homelab controller<br/>systemd · exact scanned image"]
    secrets -. "short-lived runtime projection" .-> controller

    subgraph outcomes["Capability-declared provider actions"]
        direction LR
        internal["Automatic reconcile<br/>AdGuard · NPM"]
        tls["Automatic certificate policy<br/>observe · renew · rollback"]
        publicdns["Public DNS<br/>locked until enabled"]
    end

    controller --> internal
    controller --> tls
    controller -.-> publicdns
    tls --> consumers["Verified consumers<br/>NPM · Caddy · cPanel"]
    tls --> dns01["Cloudflare DNS-01"]

    controller -->|"status + conditions"| desired
    desired --> ui["HQ<br/>health · drift · downloads · audit"]

    classDef anchor stroke-width:2px;
    class services,controller,ui anchor;
