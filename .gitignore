# Node tooling
node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.env
.env.*

# Django
*.sqlite3
*.sqlite3-journal
# Every database, upload, export, collected asset and coverage file a checkout
# writes is under var/.
var/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/

# Archives, sealed or not
*.tar.gz
*.tar.gz.age

# Programs built into the image's root-run tree (the Dockerfile's controller
# stage); a copy built here must never be committed or baked in from a checkout.
deploy/bin/

# Claude Code's local state, never published: its settings, and agent
# worktrees, where being untracked rather than ignored is a trap (a `git add
# -A` commits a nested copy of the repository into the repository). The
# project's agents and skills are the part that is published, and the
# directory is named here so a user's own ignore of `.claude/` does not hide
# them.
!/.claude/
/.claude/*
!/.claude/agents/
!/.claude/skills/
# Which local files a new agent worktree copies in (mise.local.toml).
.worktreeinclude

# Playwright MCP scratch output: screenshots and page snapshots taken while
# checking a rendered page. Evidence for a fix, not part of the app.
.playwright-mcp/
# Root-level browser captures are scratch evidence too. Product images belong
# under a named static/media directory, never beside the repository README.
/*.png
/hq-pass.json

# Personal agent settings and guidance; never published.
CLAUDE.local.md

# Type checker
.mypy_cache/
.hypothesis/

# Developer-local mise settings (tools/dev/mise.local.example.toml), and the
# proxied development server's own facts (tools/dev/dev.local.example.toml).
mise.local.toml
dev.local.toml
