htmlcov/
coverage.xml

# Agent worktrees. An isolated checkout an agent works in, which git already
# tracks as a worktree -- so it needs no second record here, and being
# untracked rather than ignored is a trap: a `git add -A` commits an entire
# nested copy of the repository into the repository. Scoped to this one
# directory because the settings file beside it is committed on purpose.
.claude/worktrees/

# Playwright MCP scratch output: screenshots and page snapshots taken while
# checking a rendered page. Evidence for a fix, not part of the app.
.playwright-mcp/
# Root-level browser captures are scratch evidence too. Product images belong
# under a named static/media directory, never beside the repository README.
/*.png
