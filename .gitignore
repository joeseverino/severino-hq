# Node tooling
node_modules/
# The tree-sitter grammars Vale reads code with, which `vale sync` installs
# from the Vale release mise.lock pins (setup:lint-tools).
/tools/lint/vale/styles/config/grammars/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.env
.env.*

# Django
*.sqlite3
*.sqlite3-journal
# Every database, upload, export, collected asset and coverage file a checkout
# writes is under var/.
var/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/

# Archives, sealed or not
*.tar.gz
*.tar.gz.age

# Programs built into the image's root-run tree (the Dockerfile's controller
# stage); a copy built here must never be committed or baked in from a checkout.
deploy/bin/

# Claude Code's local state, never published: its settings, and agent
# worktrees, where being untracked rather than ignored is a trap (a `git add
# -A` commits a nested copy of the repository into the repository).
/.claude/

# Playwright MCP scratch output: screenshots and page snapshots taken while
# checking a rendered page. Evidence for a fix, not part of the app.
.playwright-mcp/
# An image is a diagram, a documentation capture or an icon, each with its
# home; one anywhere else is a capture taken while debugging, which a public
# repository publishes the moment it is pushed.
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[gG][iI][fF]
*.[wW][eE][bB][pP]
!/docs/diagrams/**
!/docs/images/**
!/static/img/**
/hq-pass.json

# Personal agent settings and guidance; never published.
CLAUDE.local.md

# Type checker
.mypy_cache/
.hypothesis/

# Developer-local mise settings (tools/dev/mise.local.example.toml), and the
# proxied development server's own facts (tools/dev/dev.local.example.toml).
mise.local.toml
dev.local.toml
