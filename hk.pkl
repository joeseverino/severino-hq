// The linters that read one file at a time, which hk hands only the files it is
// given (mise.toml, the hk task template). Each gate is two steps:
// <gate> reads each file it is handed that its glob matches, and <gate>-whole
// reads the whole tree, run when a file it names changed (the tool's own
// config, its pins) or when the gate is run alone, on every file.
amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"

// What every gate reads besides its files: the tools' pins and the tasks.
local toolchain = List("pyproject.toml", "uv.lock", "mise.toml", "mise.lock", "mise-tasks/*.toml", "tools/pipeline/toolchain.env")
local astGrep = "ast-grep scan -c tools/lint/ast-grep/sgconfig.yml"

// Ruff and ast-grep both rewrite *.py in parallel fix steps, so a check that
// passed before the other's fix runs again on what that fix wrote.
recheck_after_fix = true

hooks {
  ["check"] {
    steps {
      // Ruff's own excludes hold for a file it is handed too (--force-exclude).
      ["ruff"] {
        glob = List("**/*.py")
        check = "uv run ruff check --force-exclude {{files}} && uv run ruff format --check --force-exclude {{files}}"
        fix = "uv run ruff check --fix-only --quiet --force-exclude {{files}} && uv run ruff format --quiet --force-exclude {{files}}"
      }
      ["ruff-whole"] {
        glob = toolchain
        check = "uv run ruff check . && uv run ruff format --check ."
        fix = "uv run ruff check --fix-only --quiet . && uv run ruff format --quiet ."
      }
      // Each rule's files: and ignores: say which modules it holds, from the
      // repository root, so a file handed to the scan is held as the whole
      // scan holds it. A suppression no match needs any more fails.
      ["ast-grep"] {
        glob = List("**/*.py")
        check = "\(astGrep) --error=unused-suppression {{files}}"
        fix = "\(astGrep) --update-all {{files}} >/dev/null"
      }
      // A rule's cases (rule-tests/) prove it refuses what it is for before its
      // scan is trusted to find nothing.
      ["ast-grep-whole"] {
        glob = List("tools/lint/ast-grep/**") + toolchain
        check = "ast-grep test -c tools/lint/ast-grep/sgconfig.yml --skip-snapshot-tests && \(astGrep) --error=unused-suppression ."
        fix = "\(astGrep) --update-all . >/dev/null"
      }
      // No fix mode: a correction can rename an identifier in one file and not
      // where it is used. _typos.toml's excludes hold for a file handed to it.
      ["spelling"] {
        glob = List("**/*")
        check = "typos --force-exclude {{files}}"
      }
      ["spelling-whole"] {
        glob = List("_typos.toml") + toolchain
        check = "typos"
      }
      // plain_words leaves out a file outside the tree Vale reads
      // (plain_words.TREE), and hands Vale the template attributes and tag
      // literals it cannot read, so one report names every finding.
      ["prose"] {
        glob = List("**/*.py", "**/*.html", "**/*.md", "**/*.js", "**/*.css", "**/*.go", "**/*.sh")
        check = "uv run python -m hq.platform.core.plain_words --changed {{files}}"
      }
      ["prose-whole"] {
        glob = List("tools/lint/vale/**", "hq/platform/core/plain_words.py", "hq/platform/core/interface_text.py") + toolchain
        check = "uv run python -m hq.platform.core.plain_words --whole"
      }
      // The sentence rule extensions are held to (plugin_validation), over
      // the host's code that builds page text; the rule leaves out tests,
      // migrations and management commands itself.
      ["sentence-ends"] {
        glob = List("hq/platform/application/**/*.py", "hq/domains/**/*.py")
        check = "uv run python -m hq.platform.application.plugin_validation . {{files}}"
      }
      ["sentence-ends-whole"] {
        glob = List("hq/platform/application/plugin_validation.py") + toolchain
        check = "uv run python -m hq.platform.application.plugin_validation . hq/platform/application hq/domains"
      }
      // The scans read every language a command line sits in, so the step
      // is handed every file and reads those that are text.
      ["source-scans"] {
        glob = List("**/*")
        check = "uv run python -m tools.source_scans {{files}}"
      }
      ["source-scans-whole"] {
        glob = List("tools/source_scans.py") + toolchain
        check = "uv run python -m tools.source_scans"
      }
      // The rules a file keeps on its own, which the extension check holds
      // an extension's files to as well; each rule names the files it reads.
      ["file-rules"] {
        glob = List("**/*.html", "**/*.css", "**/*.js", "hq/**/*.py")
        // The inbound-events Worker's pages are HQ's templates rendered, and
        // the rules read those templates.
        exclude = List("worker/public/**")
        check = "uv run python -m hq.platform.application.file_rules . {{files}}"
      }
      ["file-rules-whole"] {
        // and the declarations its rules read their words from.
        glob = List(
          "hq/platform/application/file_rules.py",
          "hq/platform/application/ui.py",
          "hq/platform/application/tone.py",
          "hq/platform/application/infrastructure.py",
          "hq/platform/application/connection_lifecycle.py",
          "hq/platform/core/table_layout.py",
          "hq/platform/core/interface_text.py",
          "hq/platform/core/example_estate/automation.py"
        ) + toolchain
        check = "uv run python -m hq.platform.application.file_rules . templates static hq tests examples"
      }
      // mise.toml's SEVERINO_FILE_LINE_* say which files the ceiling holds, so
      // the step is handed every file and keeps those.
      ["file-lines"] {
        glob = List("**/*")
        check = "uv run python -m tools.file_lines {{files}}"
      }
      ["file-lines-whole"] {
        glob = List("tools/file_lines.py") + toolchain
        check = "uv run python -m tools.file_lines"
      }
      // A changed module's lazy importers are anywhere in the tree, so the
      // step is handed the changed modules and reads every lazy import.
      ["lazy-imports"] {
        glob = List("**/*.py")
        check = "uv run python -m tools.lazy_imports {{files}}"
      }
      ["lazy-imports-whole"] {
        glob = List("tools/lazy_imports.py") + toolchain
        check = "uv run python -m tools.lazy_imports"
      }
      // mise runs a file under mise-tasks/ only when it is executable, and
      // hides one that is not; each starts with a shebang.
      ["task-modes"] {
        glob = List("mise-tasks/**")
        exclude = List("**/*.toml")
        check = "hk util check-shebang-scripts-are-executable {{files}}"
      }
      ["task-modes-whole"] {
        glob = toolchain
        check = "git ls-files -z mise-tasks ':!*.toml' | xargs -0 hk util check-shebang-scripts-are-executable"
      }
    }
  }
}
