# Copy to .env in production and fill in real values. Never commit .env.

# Core security ----------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# Comma-separated hostnames the app will answer for. List EVERY hostname
# clients actually use, or Django returns 400 "Disallowed Host". Set this to
# whatever your reverse proxy / DNS rewrite serves (e.g. hq.example.com).
DJANGO_ALLOWED_HOSTS=hq.example.com,127.0.0.1

# If you front the app with Caddy/Nginx/NPM on https, list every full origin
# here — scheme + host (no path), one per entry the browser will use.
DJANGO_CSRF_TRUSTED_ORIGINS=https://hq.example.com

# TLS / cookie security --------------------------------------------------------
# BEHIND_TLS_PROXY does two things: it lets HQ believe the proxy's
# X-Forwarded-Proto, and it turns on the redirect that stops the plain port HQ
# binds from being a second, unencrypted front door. The healthcheck path is
# exempt from that redirect; nothing else is.
DJANGO_BEHIND_TLS_PROXY=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
# With the cookies above marked Secure, HQ names them `__Host-sessionid` and
# `__Host-csrftoken`, which is a rule the browser enforces: no other host or
# path under this domain can set a cookie of that name for HQ to read back.
#
# A year, and the default. Zero used to be the advice here -- verify TLS first,
# turn it on afterwards -- and the second half is the half that gets forgotten,
# leaving a deployment that has served HTTPS for a year still telling browsers
# it is fine to try HTTP. Set it to 0 only while TLS genuinely is not working.
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
# Preload submits this name to a list compiled into browsers. Leave it off for
# a name the public internet cannot resolve; it is slow to undo.
DJANGO_HSTS_PRELOAD=0

# Time zone --------------------------------------------------------------------
DJANGO_TIME_ZONE=America/New_York

# Storage paths ----------------------------------------------------------------
# All three should live OUTSIDE the application code directory in production.
SEVERINO_DATABASE_PATH=/var/lib/severino-hq/severino.sqlite3
SEVERINO_MEDIA_ROOT=/var/lib/severino-hq/media
SEVERINO_EXPORTS_ROOT=/var/lib/severino-hq/exports
DJANGO_STATIC_ROOT=/var/lib/severino-hq/staticfiles

# Branding ---------------------------------------------------------------------
SEVERINO_SITE_NAME=Severino HQ

# Optional tuning ---------------------------------------------------------------
# Month the fiscal year starts (1-12); drives the dashboard expense KPI window.
# SEVERINO_FISCAL_YEAR_START_MONTH=1
# Days before an active doc shows up as needing review.
# SEVERINO_DOC_REVIEW_INTERVAL_DAYS=180
# Standard Python log level. Local quality checks suppress expected request noise.
# SEVERINO_LOG_LEVEL=INFO

# Pocket ID / OIDC SSO ---------------------------------------------------------
# Pocket ID callback URL:
# https://hq.example.com/oidc/callback/
SEVERINO_OIDC_ENABLED=0
SEVERINO_OIDC_ISSUER=https://sso.jseverino.com
SEVERINO_OIDC_CLIENT_ID=
SEVERINO_OIDC_CLIENT_SECRET=
# Optional fallback for providers that emit email; Pocket ID access uses groups.
# Setting this makes HQ request the `email` scope and honour the claim ONLY
# when the provider also sends `email_verified: true` -- an address nobody
# checked is something the person asserted, not an authorization. Group
# membership needs no such qualification and is the sturdier gate.
SEVERINO_OIDC_ALLOWED_EMAILS=
SEVERINO_OIDC_ALLOWED_GROUPS=admins
SEVERINO_OIDC_CREATE_USER=1

# The password form, which is on unless SSO replaces it. Left unset it follows
# SEVERINO_OIDC_ENABLED, so a fresh install signs in with a password and a
# deployment that turns SSO on closes the password door in the same step --
# rather than leaving both open, which is the state worth avoiding.
#
# Set to 1 alongside SSO only as break-glass, for when the identity provider is
# itself what is broken.
# SEVERINO_PASSWORD_LOGIN_ENABLED=0
# Attempts allowed per account and per source address before sign-in is barred
# for the window. 0 disables the throttle.
# SEVERINO_LOGIN_MAX_ATTEMPTS=5
# SEVERINO_LOGIN_WINDOW_SECONDS=900

# Who may reach HQ at all ------------------------------------------------------
# HQ answers the VPN and loopback, and refuses anything else before
# authentication runs. The default is Tailscale's IPv4 and IPv6 ranges plus
# loopback -- deliberately NOT the private LAN ranges: a home or office LAN
# holds printers, televisions and guests, and is not a trust boundary anyone
# maintains. Loopback is there for the container healthcheck and for a reverse
# proxy on the same host.
#
# Set this only if your network genuinely is the boundary, and list the exact
# ranges rather than all of RFC 1918.
# SEVERINO_ENFORCE_TRUSTED_NETWORK=1
# SEVERINO_TRUSTED_NETWORKS=100.64.0.0/10,fd7a:115c:a1e0::/48,127.0.0.0/8
# Whose X-Forwarded-For header is believed -- i.e. who may name a client other
# than themselves. Keep this to the reverse proxy; a VPN peer is a client, not
# infrastructure, and must not be able to choose the address HQ judges it by.
#
# SET THIS if HQ runs behind a proxy. The default is loopback only, so without
# it every request is attributed to the proxy itself and the audit log's source
# column stops naming real clients. Name the proxy's address exactly -- a whole
# range here lets anything inside it forge the address HQ records for a failed
# sign-in, which is also the address the login throttle reads back.
# SEVERINO_TRUSTED_PROXIES=127.0.0.1/32,192.0.2.10/32

# Public lookups ---------------------------------------------------------------
# The two questions HQ cannot answer from inside its own network: what a
# resolver outside it returns for a name, and who a public address belongs to.
# Neither call carries a credential. Blank either endpoint to disable that
# half fail-closed; blank both and the Tools tab disappears.
# SEVERINO_LOOKUP_ENDPOINT=https://dns-lookup.com
# SEVERINO_RDAP_ENDPOINT=https://rdap.org
# SEVERINO_LOOKUP_TIMEOUT_SECONDS=6
# Whether the MCP service account may spend an outbound lookup. Off by default:
# an unattended caller reaching a third party is a deployment's decision.
# SEVERINO_MCP_ENABLE_LOOKUP=0

# Machine API -----------------------------------------------------------------
# Empty disables the API. This must equal the Pocket ID API resource/audience.
SEVERINO_API_RESOURCE=
# Successful mutation responses are replayable for this window (24h default).
SEVERINO_API_IDEMPOTENCY_TTL_SECONDS=86400

# Severino HQ MCP --------------------------------------------------------------
# MCP is disabled unless the token is at least 32 characters and allowed hosts
# are explicitly configured. Connect directly over Tailscale; do not use NPM.
# Production uses SEVERINO_MCP_TOKEN_FILE_HOST to mount a validator copy
# provisioned from 1Password. Never put SEVERINO_MCP_TOKEN in this file.
SEVERINO_MCP_TOKEN_FILE_HOST=/path/to/root-only/severino_mcp_token
SEVERINO_MCP_ALLOWED_HOSTS=your-tailscale-ip,your-magicdns-hostname
# Defaults cover Tailscale IPv4 + IPv6. Set only to narrow them further.
# SEVERINO_MCP_ALLOWED_NETWORKS=100.64.0.0/10,fd7a:115c:a1e0::/48
# Browser Origins are rejected unless explicitly listed. Leave empty for Codex.
SEVERINO_MCP_ALLOWED_ORIGINS=
# MCP mutations are independently fail-closed. Enable ordinary writes only
# after the tailnet/auth boundary is configured. Pruning and record deletion
# each require their own additional switch.
SEVERINO_MCP_ENABLE_WRITES=0
# Vault documentation-index mirroring only (what `hq sync` needs).
# Separate from ENABLE_WRITES so doc sync does not require granting
# write access to expenses, receipts, projects, assets and content.
SEVERINO_MCP_ENABLE_DOC_SYNC=0
SEVERINO_MCP_ENABLE_PRUNE=0
SEVERINO_MCP_ENABLE_DELETES=0
SEVERINO_MCP_ENABLE_INFRASTRUCTURE=0
# Certificate renewal requests, separate from declaring infrastructure.
SEVERINO_MCP_ENABLE_CERT_RENEWAL=0
# Public DNS declarations remain disabled and cannot reconcile unless this
# separate deployment-level policy switch is deliberately enabled.
SEVERINO_INFRASTRUCTURE_ENABLE_PUBLIC_DNS=0
# Public root certificate only; no private CA material enters HQ.
SEVERINO_CONTROLLER_CA_FILE_HOST=/usr/local/share/ca-certificates/severino-labs-root-ca.crt

# Cloudflare D1 ----------------------------------------------------------------
# Read/write access to the jseverino.com contact-form submissions database.
# CLOUDFLARE_API_TOKEN: create a token with the "D1 Edit" permission.
# CLOUDFLARE_D1_DATABASE_ID is the jseverino-contact database id (not secret).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=53ad6f75-644d-44b1-a0b4-04261f9335db
CLOUDFLARE_API_TOKEN=

# Optional authenticated GitHub metadata reads for registered HQ projects.
# Without a token, public repository refreshes still work at GitHub's anonymous
# rate limit; setting one also emits the credential on HQ's Connections graph.
GITHUB_API_TOKEN=
# Explicit allowlist of trusted package.module:PluginManifest entry points.
SEVERINO_HQ_PLUGINS=
