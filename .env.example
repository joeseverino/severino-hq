# Copy to .env in production and fill in real values. Never commit .env.

# Core security ----------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# Comma-separated hostnames the app will answer for. List EVERY hostname
# clients actually use, or Django returns 400 "Disallowed Host". Set this to
# whatever your reverse proxy / DNS rewrite serves (e.g. hq.example.com).
DJANGO_ALLOWED_HOSTS=hq.example.com,127.0.0.1

# If you front the app with Caddy/Nginx/NPM on https, list every full origin
# here — scheme + host (no path), one per entry the browser will use.
DJANGO_CSRF_TRUSTED_ORIGINS=https://hq.example.com

# TLS / cookie security --------------------------------------------------------
DJANGO_BEHIND_TLS_PROXY=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_HSTS_SECONDS=0           # set to 31536000 only after you've verified TLS

# Time zone --------------------------------------------------------------------
DJANGO_TIME_ZONE=America/New_York

# Storage paths ----------------------------------------------------------------
# All three should live OUTSIDE the application code directory in production.
SEVERINO_DATABASE_PATH=/var/lib/severino-hq/severino.sqlite3
SEVERINO_MEDIA_ROOT=/var/lib/severino-hq/media
SEVERINO_EXPORTS_ROOT=/var/lib/severino-hq/exports
DJANGO_STATIC_ROOT=/var/lib/severino-hq/staticfiles

# Branding ---------------------------------------------------------------------
SEVERINO_SITE_NAME=Severino HQ

# Optional tuning ---------------------------------------------------------------
# Month the fiscal year starts (1-12); drives the dashboard expense KPI window.
# SEVERINO_FISCAL_YEAR_START_MONTH=1
# Days before an active doc shows up as needing review.
# SEVERINO_DOC_REVIEW_INTERVAL_DAYS=180

# Pocket ID / OIDC SSO ---------------------------------------------------------
# Pocket ID callback URL:
# https://hq.example.com/oidc/callback/
SEVERINO_OIDC_ENABLED=0
SEVERINO_OIDC_ISSUER=https://sso.jseverino.com
SEVERINO_OIDC_CLIENT_ID=
SEVERINO_OIDC_CLIENT_SECRET=
# Optional fallback for providers that emit email; Pocket ID access uses groups.
SEVERINO_OIDC_ALLOWED_EMAILS=
SEVERINO_OIDC_ALLOWED_GROUPS=admins
SEVERINO_OIDC_CREATE_USER=1

# Severino HQ MCP --------------------------------------------------------------
# MCP is disabled unless the token is at least 32 characters and allowed hosts
# are explicitly configured. Connect directly over Tailscale; do not use NPM.
# Production uses SEVERINO_MCP_TOKEN_FILE_HOST to mount a validator copy
# provisioned from 1Password. Never put SEVERINO_MCP_TOKEN in this file.
SEVERINO_MCP_TOKEN_FILE_HOST=/path/to/root-only/severino_mcp_token
SEVERINO_MCP_ALLOWED_HOSTS=your-tailscale-ip,your-magicdns-hostname
# Defaults cover Tailscale IPv4 + IPv6. Set only to narrow them further.
# SEVERINO_MCP_ALLOWED_NETWORKS=100.64.0.0/10,fd7a:115c:a1e0::/48
# Browser Origins are rejected unless explicitly listed. Leave empty for Codex.
SEVERINO_MCP_ALLOWED_ORIGINS=
# MCP mutations are independently fail-closed. Enable ordinary writes only
# after the tailnet/auth boundary is configured. Pruning and record deletion
# each require their own additional switch.
SEVERINO_MCP_ENABLE_WRITES=0
# Vault documentation-index mirroring only (what `hq sync` needs).
# Separate from ENABLE_WRITES so doc sync does not require granting
# write access to expenses, receipts, projects, assets and content.
SEVERINO_MCP_ENABLE_DOC_SYNC=0
SEVERINO_MCP_ENABLE_PRUNE=0
SEVERINO_MCP_ENABLE_DELETES=0
SEVERINO_MCP_ENABLE_INFRASTRUCTURE=0
# Certificate renewal requests, separate from declaring topology.
SEVERINO_MCP_ENABLE_CERT_RENEWAL=0
# Public DNS declarations remain disabled and cannot reconcile unless this
# separate deployment-level policy switch is deliberately enabled.
SEVERINO_INFRASTRUCTURE_ENABLE_PUBLIC_DNS=0
# Public root certificate only; no private CA material enters HQ.
SEVERINO_CONTROLLER_CA_FILE_HOST=/usr/local/share/ca-certificates/severino-labs-root-ca.crt

# Cloudflare D1 ----------------------------------------------------------------
# Read/write access to the jseverino.com contact-form submissions database.
# CLOUDFLARE_API_TOKEN: create a token with the "D1 Edit" permission.
# CLOUDFLARE_D1_DATABASE_ID is the jseverino-contact database id (not secret).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=53ad6f75-644d-44b1-a0b4-04261f9335db
CLOUDFLARE_API_TOKEN=
# Explicit allowlist of trusted package.module:PluginManifest entry points.
SEVERINO_HQ_PLUGINS=
